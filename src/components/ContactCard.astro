---
// src/components/ContactCard.astro
interface Props {
  title: string;
  description: string;
  emailUser: string;      // Parte local (antes del @)
  emailDomain: string;    // Dominio (después del @)
}

const { title, description, emailUser, emailDomain } = Astro.props;
const emailFull = `${emailUser}@${emailDomain}`;
---

<section 
  class="contact-section bg-white p-6 md:p-8 rounded-lg shadow-md border border-platinum mb-6 last:mb-0"
  itemscope 
  itemtype="https://schema.org/ContactPoint"
>
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
    <!-- Contenido principal -->
    <div class="flex-1">
      <h2 class="text-h2 font-advent mb-3" itemprop="name">{title}</h2>
      <p class="mb-4 text-slate-700 leading-relaxed">{description}</p>
      
      <!-- Email ofuscado + copiar -->
      <div class="email-container flex items-center gap-3 flex-wrap mt-4">
        <span class="text-slate-600 text-sm font-medium">Contacto:</span>
        <a 
          href="#" 
          class="email-link text-teal-700 hover:text-teal-900 font-mono text-sm underline decoration-dotted"
          data-user={emailUser}
          data-domain={emailDomain}
          itemprop="email"
          aria-label={`Correo electrónico: ${emailFull}`}
          onclick="event.preventDefault(); window.location.href='mailto:' + this.dataset.user + '@' + this.dataset.domain;"
        >
          <span class="email-user"></span><span class="email-at">@</span><span class="email-domain"></span>
        </a>
        
        <button 
          type="button"
          class="copy-btn-compact text-xs px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded border border-slate-300 transition focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2"
          data-email={emailFull}
          aria-label={`Copiar dirección: ${emailFull}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copiar
        </button>
        
        <span class="copy-feedback text-xs text-green-600 hidden" aria-live="polite" role="status">
          ✓ Copiado
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  // Ofuscación: reconstruir emails solo en cliente
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.contact-section');
    
    sections.forEach(section => {
      const link = section.querySelector('.email-link');
      if (!link) return;
      
      // ✅ Casting a HTMLElement para acceder a dataset
      const linkEl = link as HTMLElement;
      const user = linkEl.dataset.user;
      const domain = linkEl.dataset.domain;
      
      // Insertar partes del email (ofuscado en HTML estático)
      const userSpan = link.querySelector('.email-user');
      const domainSpan = link.querySelector('.email-domain');
      if (userSpan) userSpan.textContent = user || '';
      if (domainSpan) domainSpan.textContent = domain || '';
      
      // Botón copiar
      const copyBtn = section.querySelector('.copy-btn-compact');
      const feedback = section.querySelector('.copy-feedback');
      
      if (copyBtn) {
        copyBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          // ✅ Casting para dataset en botón
          const email = (copyBtn as HTMLElement).dataset.email || '';
          
          try {
            await navigator.clipboard.writeText(email);
            if (feedback) {
              feedback.classList.remove('hidden');
              setTimeout(() => feedback.classList.add('hidden'), 2000);
            }
          } catch (err) {
            // Fallback para navegadores antiguos
            const textarea = document.createElement('textarea');
            textarea.value = email;
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            document.body.appendChild(textarea);
            textarea.select();
            try { document.execCommand('copy'); } catch {}
            document.body.removeChild(textarea);
            if (feedback) {
              feedback.textContent = '✓ Copiado';
              feedback.classList.remove('hidden');
              setTimeout(() => {
                feedback.classList.add('hidden');
                feedback.textContent = '✓ Copiado';
              }, 2000);
            }
          }
        });
      }
    });
  });
</script>