---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import '../styles/globals.css';
// ✅ NO importamos slider.js aquí → se carga solo en el cliente
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title || 'Dag Klassical BCT'}</title>
    <meta
      name="description"
      content={Astro.props.description || 'Tecnología Blockchain aplicada a la música clásica.'}
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Advent+Pro:wght@400;500;600;700&family=Montserrat:ital,wght@0,300;0,400;1,300&family=Source+Code+Pro:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Asegúrate de que Tailwind u otros estilos estén configurados en astro.config.mjs -->
  </head>
  <body class="font-['Montserrat'] min-h-screen bg-gray95 text-slate-900 flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Franja de migas de pan SOBRE el footer -->
    <div class="bg-slate-800 text-white">
      <div class="max-w-6xl mx-auto px-4 py-2">
        <nav aria-label="Breadcrumb">
          {Astro.url.pathname === '/' ? (
            <div class="text-sm text-white font-light mx-4 py-2">
              Aquí verá&nbsp;&nbsp;su ruta de navegación
            </div>
          ) : Astro.props.breadcrumbs && Astro.props.breadcrumbs.length > 0 ? (
            <Breadcrumb items={Astro.props.breadcrumbs} />
          ) : null}
        </nav>
      </div>
    </div>

    <Footer />

    <!-- Scroll to top button (ajusta el contenido según tu implementación) -->
    <button
      id="scroll-to-top"
      class="fixed bottom-6 right-6 bg-slate-800 text-white p-2 rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity"
      aria-label="Volver arriba"
    >
      ↑
    </button>

    <!-- ✅ Slider: solo en cliente, sin errores SSR -->
    <script is:client>
      import '../scripts/slider.js';
    </script>

    <!-- ✅ Script de scroll-to-top: seguro en cliente -->
    <script is:client>
      const button = document.getElementById('scroll-to-top');
      if (button) {
        window.addEventListener('scroll', () => {
          button.classList.toggle('opacity-100', window.scrollY > 300);
          button.classList.toggle('pointer-events-auto', window.scrollY > 300);
        });
        button.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>