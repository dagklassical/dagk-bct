---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import '../styles/globals.css';
// ✅ NO importamos slider.js aquí → se carga solo en el cliente
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title || 'Dag Klassical BCT'}</title>
    <meta
      name="description"
      content={Astro.props.description || 'Tecnología Blockchain aplicada a la música clásica.'}
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Advent+Pro:wght@400;500;600;700&family=Montserrat:ital,wght@0,300;0,400;1,300&family=Source+Code+Pro:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Asegúrate de que Tailwind u otros estilos estén configurados en astro.config.mjs -->
  </head>
  <body class="font-['Montserrat'] min-h-screen bg-gray95 text-slate-900 flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    <!-- Marquesina Blockchain - Casa de Cambio -->
<div class="bg-white border-t border-b border-platinum/20 py-1.5 overflow-hidden">
  <div class="marquee-container whitespace-nowrap font-['Source_Code_Pro'] text-xs text-slate-600">
   <span class="marquee-content">
  {`MATIC: ${import.meta.env.MATIC_PRICE || '0.84'} ▲ | USDC: $${import.meta.env.USDC_PRICE || '1.00'} ▮ | Certificados DAG: ${import.meta.env.TOTAL_CERTIFICADOS || '0'} | Último Mint: --`}
  &nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;
  {`MATIC: ${import.meta.env.MATIC_PRICE || '0.84'} ▲ | USDC: $${import.meta.env.USDC_PRICE || '1.00'} ▮ | Certificados DAG: ${import.meta.env.TOTAL_CERTIFICADOS || '0'} | Último Mint: --`}
</span>
  </div>
</div>

<style>
  .marquee-container {
    display: block;
    width: 100%;
    overflow: hidden;
  }
  .marquee-content {
    display: inline-block;
    padding-left: 100%; /* Empieza fuera, a la derecha */
    animation: marquee 25s linear infinite;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }       /* Empieza con padding-left → visible en la derecha */
    100% { transform: translateX(-100%); } /* Se desplaza hasta salir por la izquierda */
  }
</style>
    </main>

    <!-- Franja de migas de pan SOBRE el footer -->
    <div class="bg-slate-800 text-white">
      <div class="max-w-6xl mx-auto px-4 py-2">
        <nav aria-label="Breadcrumb">
          {Astro.url.pathname === '/' ? (
            <div class="text-sm text-white font-light mx-4 py-2">
              Aquí verá&nbsp;&nbsp;su ruta de navegación
            </div>
          ) : Astro.props.breadcrumbs && Astro.props.breadcrumbs.length > 0 ? (
            <Breadcrumb items={Astro.props.breadcrumbs} />
          ) : null}
        </nav>
      </div>
    </div>

    <Footer />

    <!-- Scroll to top button (ajusta el contenido según tu implementación) -->
    <button
      id="scroll-to-top"
      class="fixed bottom-6 right-6 bg-slate-800 text-white p-2 rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity"
      aria-label="Volver arriba"
    >
      ↑
    </button>

    <!-- Script del slider cargado desde public/ -->
    <script src="/scripts/slider.js" defer></script>

    <!-- ✅ Script de scroll-to-top: seguro en cliente -->
    <script type="module" is:client>
      const button = document.getElementById('scroll-to-top');
      if (button) {
        window.addEventListener('scroll', () => {
          button.classList.toggle('opacity-100', window.scrollY > 300);
          button.classList.toggle('pointer-events-auto', window.scrollY > 300);
        });
        button.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>