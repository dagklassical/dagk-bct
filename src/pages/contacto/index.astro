---
// src/pages/contacto/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContactCard from '../../components/ContactCard.astro';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Contacto', href: '/contacto/' },
];

const pageTitle = 'Contacto - Dag Klassical BCT';
const pageDescription = 'Canales de contacto para artistas, prensa e inversores. Conéctate con la plataforma de música verificable.';
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <div class="max-w-3xl mx-auto px-4 py-12">
    
    <!-- Header -->
    <header class="text-center mb-10">
      <h1 class="text-h1 font-advent font-bold mb-4">Conéctate con Dag Klassical</h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Estamos aquí para artistas, prensa, inversores y amantes de la música verificable. 
        Selecciona el área que corresponda a tu consulta.
      </p>
    </header>

    <!-- Secciones principales: 3 filas con ContactCard -->
    <div class="flex flex-col">
      <ContactCard 
        title="Artistas"
        description="¿Eres compositor, intérprete o productor? Únete a nuestra plataforma de música clásica y contemporánea con certificación blockchain."
        emailUser="artistas"
        emailDomain="dagklassical.com"
      />
      
      <ContactCard 
        title="Prensa"
        description="Entrevistas, reseñas, cobertura de lanzamientos y eventos. Accede a kits de prensa y material exclusivo."
        emailUser="prensa"
        emailDomain="dagklassical.com"
      />
      
      <ContactCard 
        title="Comercial"
        description="Oportunidades de inversión, patrocinio y colaboración empresarial. Explora Music Cards con valor verificable."
        emailUser="comercial"
        emailDomain="dagklassical.com"
      />
    </div>

    <!-- Footer: nota discreta (sin componentes, solo texto) -->
    <div class="mt-12 pt-8 border-t border-slate-200 text-center text-slate-600 text-sm font-Source-Code-Pro">
      <p>Todas las consultas recibirán respuesta en un plazo de <strong>24 a 48 horas hábiles</strong>.</p>
      <p class="mt-2">
        Para soporte técnico relacionado con tu Music Card (acceso, descargas, verificación), escribe a 
        <strong><span class="hover:dag-burgundy transition">
          cto@dagklassical.com</span></strong> incluyendo el <strong>UUID</strong> de tu activo digital en el mensaje.
      </p>
    </div>
    
  </div>
</Layout>