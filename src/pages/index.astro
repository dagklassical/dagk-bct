---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
];

// ✅ Cargar datos desde Content Collections
const allArtists = await getCollection('artists');
const allMusicCards = await getCollection('music-cards');
const allNoticias = await getCollection('noticias');

// Procesar artistas
const artists = allArtists.map(a => a.data);

// Procesar Music Cards (filtrar disponibles/próximos)
const musicCards = allMusicCards.map(m => m.data);
const latestReleases = musicCards
  .filter(card => card.status === 'disponible' || card.status === 'próximo')
  .slice(0, 8); // Mostrar 8 en home para mejor grid

// Procesar noticias (ordenadas por fecha, últimas 3)
const latestNews = allNoticias
  .filter(post => {
    const d = new Date(post.data.date);
    return d instanceof Date && !isNaN(d.getTime());
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<Layout title="DAG Klassical BCT" description="Tecnología Blockchain aplicada a la música digital verificable." breadcrumbs={breadcrumbs}>
  
  <!-- ========================================
       HERO SLIDER (SPLIDE)
       ======================================== -->
  <style>
    #main-hero-slider,
    #main-hero-slider .splide__track,
    #main-hero-slider .splide__list,
    #main-hero-slider .splide__slide {
      height: 100%;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
  </style>

  <section class="relative w-full h-[85vh] md:h-screen lg:h-[80vh] overflow-hidden">
    <div id="main-hero-slider" class="splide">
      <div class="splide__track">
        <ul class="splide__list">
          
          <!-- SLIDE 1: DISCOGRAFÍA -->
          <li class="splide__slide relative">
            <img 
              src="/hero/hero-discografia-02.webp" 
              alt="Explora nuestra discografía" 
              class="w-full h-full object-cover object-[30%_55%]" 
            />
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center p-4">
              <div class="w-full max-w-prose text-center md:text-left text-white py-4 md:mt-48">
                <h2 class="text-h2 sm:text-4xl md:text-5xl font-advent font-bold mb-8">Descubre la Discografía</h2>
                <p class="hidden md:block text-lg md:text-xl mb-8 opacity-90">
                  Obras maestras interpretadas por artistas de clase mundial, con una calidad de audio inigualable.
                </p>
                <a href="/musica/discografia" class="btn-primary text-lg px-8 py-3 my-8">
                  Explorar Ahora
                </a>
              </div>
            </div>
          </li>

          <!-- SLIDE 2: MUSIC CARDS -->
          <li class="splide__slide relative">
            <img 
              src="/hero/hero-music-cards-latam.webp" 
              alt="Adquiere una Music Card" 
              class="w-full h-full object-cover object-[86%_25%]"
            />
            <div class="absolute inset-0 bg-black/30 flex items-end justify-center p-4 md:justify-end">
              <div class="w-full max-w-[60rem] mx-auto text-center md:text-left text-white pb-4 md:py-8 mb-8 md:mb-0">
                <h2 class="text-h2 sm:text-4xl md:text-5xl font-advent font-bold mb-8">Colecciona la Música</h2>
                <p class="hidden md:block text-lg md:text-xl opacity-90 mb-8">
                  Un compás de la historia en nuestras Music Cards NFT. <br/>Un recuerdo digital verificable y tuyo para siempre.
                </p>
                <a href="/blockchain/music-cards" class="btn-primary text-lg px-8 py-3 my-8">
                  Ver Colección
                </a>
              </div>
            </div>
          </li>

        </ul>
      </div>
    </div>
  </section>

  <!-- ========================================
       1. ARTISTAS → Carousel full-width (estilo /musica)
       ======================================== -->
  <section class="w-full overflow-hidden px-4 py-12 bg-platinum">
    <div class="text-center mb-8">
      <h3 class="text-xl md:text-2xl font-advent font-medium text-slate-800 max-w-3xl mx-auto">
        Artistas que dan vida a cada obra.
      </h3>
    </div>
    
    <div class="flex overflow-x-auto pb-4 -mx-2 hide-scrollbar">
      {artists.map((artist) => (
        <div class="flex-shrink-0 px-2 w-48">
          <a href={`/musica/artistas/${artist.id}`} class="block text-center group">
            <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden">
              <div class="aspect-[4/5]">
                {artist.avatar ? (
                  <img 
                    src={artist.avatar} 
                    alt={artist.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    onerror="this.src='/images/artists/300x400.svg'"
                  />
                ) : (
                  <img 
                    src="/images/artists/300x400.svg" 
                    alt={artist.name}
                    class="w-full h-full object-cover opacity-50"
                    loading="lazy"
                  />
                )}
              </div>
            </div>
            <h3 class="mt-3 font-semibold text-slate-800 group-hover:text-dag-burgundy transition-colors text-sm">
              {artist.name}
            </h3>
          </a>
        </div>
      ))}
    </div>
    
    <div class="text-center mt-6">
      <a href="/musica/artistas" class="btn-primary inline-block px-6 py-3">
        Explorar Todos los Artistas
      </a>
    </div>
  </section>

  <!-- ========================================
       2. MUSIC CARDS → Grid centrado (estilo /musica)
       ======================================== -->
  <section class="py-16 bg-gray95">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-10">
        <h3 class="text-xl md:text-2xl font-advent font-medium text-slate-800 max-w-3xl mx-auto">
          Colecciones únicas con autenticidad digital y acceso exclusivo.
        </h3>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
        {latestReleases.map((card) => (
          <a 
            href={`/blockchain/music-cards/${card.id}`} 
            class="group block bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden"
          >
            <div class="aspect-[5/8]">
              <img 
                src={card.cardImage || '/images/placeholder-card.jpg'} 
                alt={card.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h4 class="text-sm font-bold font-advent text-slate-900 group-hover:text-dag-burgundy truncate">
                {card.title}
              </h4>
              <p class="text-xs text-slate-500 truncate mt-1">
                {card.artist || 'Artista'}
              </p>
            </div>
          </a>
        ))}
      </div>
      
      <div class="text-center mt-8">
        <a href="/blockchain/music-cards" class="btn-primary inline-block px-6 py-3">
          Explorar Music Cards
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================
       3. FEATURES → Valores (título unificado)
       ======================================== -->
  <section class="py-16 bg-platinum">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-10">
        <h3 class="text-xl md:text-2xl font-advent font-medium text-slate-800 max-w-3xl mx-auto">
          Nuestra promesa: música con integridad, tecnología con propósito.
        </h3>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center p-6 bg-white rounded-lg shadow-sm border border-platinum">
          <h4 class="text-h4 font-advent text-slate-900 mb-3">Música Verificable</h4>
          <p class="text-slate-600">Cada lanzamiento está respaldado por metadatos inmutables cuya autenticidad se puede comprobar en blockchain.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-lg shadow-sm border border-platinum">
          <h4 class="text-h4 font-advent text-slate-900 mb-3">Music Cards Únicas</h4>
          <p class="text-slate-600">Colecciona activos digitales únicos asociados a lanzamientos exclusivos de DAG Klassical.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-lg shadow-sm border border-platinum">
          <h4 class="text-h4 font-advent text-slate-900 mb-3">Tecnología Transparente</h4>
          <p class="text-slate-600">Utilizamos Polygon para garantizar seguridad, trazabilidad y bajas emisiones de carbono.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ========================================
       4. NOTICIAS → Al final, como footer de contenido
       ======================================== -->
  <section class="py-16 bg-white border-t border-platinum">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-10">
        <h3 class="text-xl md:text-2xl font-advent font-medium text-slate-800 max-w-3xl mx-auto">
          Mantente al día con el pulso de la revolución musical.
        </h3>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestNews.map((post) => {
          const { title, image, tags } = post.data;
          const slug = post.slug;
          const primaryTag = tags?.[0];
          return (
            <a href={`/noticias/${slug}`} class="block group h-full">
              <div class="bg-platinum border border-platinum rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow h-full flex flex-col">
                {image && (
                  <div class="relative aspect-[4/3] overflow-hidden">
                    <img 
                      src={image} 
                      alt={title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                    {primaryTag && (
                      <span class="absolute top-3 left-3 bg-dag-burgundy text-white text-[0.65rem] font-bold px-2 py-1 rounded uppercase tracking-wide z-10">
                        {primaryTag}
                      </span>
                    )}
                  </div>
                )}
                <div class="p-5 flex-grow flex flex-col">
                  <h4 class="text-lg font-advent font-bold text-slate-800 group-hover:text-dag-burgundy transition-colors line-clamp-2">
                    {title}
                  </h4>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      
      <div class="text-center mt-8">
        <a href="/noticias" class="text-dag-burgundy font-medium hover:underline">
          Ver todas las noticias →
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================
       5. CTA → Artistas / Inversionistas
       ======================================== -->
  <section class="py-16 bg-gray95 text-center">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-10">
        <h3 class="text-xl md:text-2xl font-advent font-medium text-slate-800 max-w-3xl mx-auto">
          ¿Eres artista o inversionista?
        </h3>
      </div>
      
      <p class="text-lg max-w-2xl mx-auto mb-8 text-slate-700">
        Descubre cómo DAG Klassical BCT puede transformar la forma en que creas, distribuyes y valoras la música digital.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/nosotros" class="inline-block bg-slate-800 text-white px-6 py-3 rounded-lg hover:bg-slate-700 transition-colors">
          Conócenos
        </a>
        <a href="/contacto" class="inline-block bg-dag-burgundy text-white px-6 py-3 rounded-lg hover:bg-opacity-80 transition-colors">
          Contacto
        </a>
      </div>
    </div>
  </section>



</Layout>
