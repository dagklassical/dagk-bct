---
// src/pages/musica/discografia/index.astro
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { resolveCover } from '../../../lib/asset-resolver';

export const prerender = true;

// ✅ Obtener datos de Content Collections
const allReleases = await getCollection('releases');
const allArtists = await getCollection('artists');

const releases = allReleases.map(r => r.data);
const artists = allArtists.map(a => a.data);

// ✅ FILTRAR SOLO LOS PUBLICADOS (status: lanzado)
const publishedReleases = releases.filter(r => r.status === 'lanzado');

// ✅ Ordenar por fecha (más recientes primero)
const sortedReleases = [...publishedReleases].sort((a, b) => 
  new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime()
);

// Helper: obtener nombres de intérpretes
const getPerformerNames = (release: typeof releases[0]) => {
  if (release.artistIds) {
    return release.artistIds
      .map((id: string) => artists.find(a => a.id === id)?.name)
      .filter(Boolean)
      .join(', ') || 'Intérpretes no especificados';
  }
  return 'Intérpretes no especificados';
};

// ✅ Extraer artistas únicos que tienen releases publicados
const artistsWithReleases = [...new Set(
  publishedReleases
    .flatMap(r => r.artistIds || [])
    .filter(Boolean)
)].map(artistId => {
  const artist = artists.find(a => a.id === artistId);
  return artist ? { id: artist.id, name: artist.name } : null;
}).filter((artist): artist is { id: string; name: string } => artist !== null)
  .sort((a, b) => a.name.localeCompare(b.name));

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Música', href: '/musica' },
  { label: 'Discografía', href: '/musica/discografia' },
];
---

<Layout 
  title="Discografía | DAG Klassical" 
  description="Explora nuestra colección de obras musicales certificadas en blockchain."
  breadcrumbs={breadcrumbs}
>
    <!-- ===================================
       HEADER CON FILTRO EN UNA LÍNEA
       =================================== -->
  <header class="bg-white text-center py-10 px-4 mb-8">
    <h1 class="text-h1 font-advent mb-6">Nuestra Discografía</h1>
    
    <!-- Filtro + Contador en una línea -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 max-w-2xl mx-auto">
      <span class="text-dag-burgundy text-md whitespace-nowrap">El arreglo para</span>
      
      <div class="relative w-full sm:w-auto min-w-[200px]">
        <select 
          id="artist-filter"
          class="w-full px-4 py-2 pr-10 border border-dag-platinum rounded-md text-sm bg-white focus:outline-none focus:ring-1 focus:ring-dag-burgundy/50 appearance-none cursor-pointer transition-shadow hover:shadow-sm"
        >
          <option value="todos">Todos los artistas</option>
          {artistsWithReleases.map(artist => (
            <option value={artist.id}>
              {artist.name}
            </option>
          ))}
        </select>
        <!-- Icono de flecha -->
        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">
          <svg class="w-4 h-4 text-dag-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>
      
      <span class="text-dag-burgundy text-md whitespace-nowrap">
        <span id="releases-count" class="font-semibold">{sortedReleases.length}</span> lanzamientos
      </span>
    </div>
  </header>

  <main class="bg-gray95 pb-12">
    <div class="max-w-6xl mx-auto px-8">
      
      <!-- ===================================
           GRID DE RELEASES (SOLO PUBLICADOS)
           =================================== -->
      <div id="releases-grid" class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-5">
        {sortedReleases.map(release => {
          const performers = getPerformerNames(release);
          const genres = Array.isArray(release.genre) 
            ? release.genre 
            : (release.genre ? [release.genre] : []);
          
          const displayGenres = genres.slice(0, 2);
          const extraCount = genres.length - 2;
          if (extraCount > 0) {
            displayGenres.push(`+${extraCount}`);
          }

          const coverUrl = resolveCover(release.coverImage);

          return (
            <a 
              href={`/musica/discografia/${release.id}`} 
              class="release-card block group bg-white rounded-md overflow-hidden shadow-sm hover:shadow-lg transition-shadow h-full"
              data-artists={(release.artistIds || []).join(' ')}
            >
              <div class="aspect-[1/1] relative">
                <img 
                  src={coverUrl || '/images/placeholder-cover.webp'} 
                  alt={`${release.workTitle || release.title} por ${performers}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
                <div class="absolute top-2 left-2 flex flex-wrap gap-1">
                  {displayGenres.map((g, i) => (
                    <span
                      class={`text-xs px-1.5 py-0.5 rounded ${
                        g.startsWith('+') 
                          ? 'bg-gray/70 text-slate-700' 
                          : 'bg-white/70 text-slate-900 border border-platinum'
                      } group-hover:bg-dag-burgundy group-hover:text-white transition-colors`}
                    >
                      {g.replace(/-/g, ' ')}
                    </span>
                  ))}
                </div>
              </div>
              <div class="p-3">
                <h3 class="font-advent font-semibold text-slate-900 group-hover:text-dag-burgundy text-h4 sm:text-lg mb-1">
                  {release.workTitle || release.title}
                </h3>
                {release.composer && (
                  <p class="text-xs text-slate-500 mb-1 line-clamp-1">Obra de {release.composer}</p>
                )}
                <p class="text-xs text-slate-600 mb-1 line-clamp-1">{performers}</p>
                <p class="text-xs text-dag-burgundy mt-1">
                  {release.type} • {release.duration}
                  {release.releaseDate && (
                    <span class="text-[10px] text-slate-500 ml-1">
                      • {new Date(release.releaseDate).toLocaleDateString('es-ES')}
                    </span>
                  )}
                </p>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Mensaje si no hay resultados -->
      <div id="no-results" class="hidden text-center py-12 bg-white rounded-xl border border-platinum mt-8">
        <p class="text-slate-600 mb-4">No se encontraron releases para este artista.</p>
        <button 
          onclick="document.getElementById('artist-filter').value = 'todos'; document.getElementById('artist-filter').dispatchEvent(new Event('change'));"
          class="text-dag-burgundy hover:underline text-sm"
        >
          Ver todos los releases
        </button>
      </div>
    </div>

    <div class="text-center mt-8 sm:mt-10">
      <a 
        href="/musica" 
        class="inline-block bg-dag-burgundy text-white px-4 py-2 sm:px-5 sm:py-2.5 rounded-lg hover:bg-opacity-90 transition-colors text-sm"
      >
        Volver a Música
      </a>
    </div>
  </main>

  <!-- ===================================
       SCRIPT DE FILTRADO (CLIENTE, SIN RECARGA)
       =================================== -->
  <script>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', function() {
      var artistFilter = document.getElementById('artist-filter');
      var releaseCards = document.querySelectorAll('.release-card');
      var countDisplay = document.getElementById('releases-count');
      var noResults = document.getElementById('no-results');
      var gridContainer = document.getElementById('releases-grid');

      if (!artistFilter || !countDisplay || !noResults || !gridContainer) return;

      function applyArtistFilter(selectedArtist) {
        var visibleCount = 0;
        
        releaseCards.forEach(function(card) {
          var artists = (card.dataset.artists || '').split(' ');
          var show = selectedArtist === 'todos' || artists.includes(selectedArtist);
          card.style.display = show ? 'block' : 'none';
          if (show) visibleCount++;
        });

        countDisplay.textContent = visibleCount;

        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          gridContainer.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          gridContainer.classList.remove('hidden');
        }
      }

      artistFilter.addEventListener('change', function() {
        applyArtistFilter(this.value);
      });
    });
  </script>
</Layout>