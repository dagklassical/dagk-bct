---
// src/pages/musica/discografia/[id].astro
import Layout from '../../../layouts/Layout.astro';
import ImmutableStamp from '../../../components/ImmutableStamp.astro';
import { getCollection, getEntry } from 'astro:content';

export const prerender = true;

// ✅ getStaticPaths PRIMERO con sus propias variables
export async function getStaticPaths() {
  const allReleases = await getCollection('releases');
  const releases = allReleases.map(r => r.data);
  
  return releases.map(release => ({ 
    params: { id: release.id } 
  }));
}

// ✅ Ahora las variables para el resto del componente
const allReleases = await getCollection('releases');
const releases = allReleases.map(r => r.data);

const allMusicCards = await getCollection('music-cards');
const musicCards = allMusicCards.map(m => m.data);

const allArtists = await getCollection('artists');
const artists = allArtists.map(a => a.data);

const { id } = Astro.params;
const releaseEntry = await getEntry('releases', id);
const release = releaseEntry?.data;

if (!release) {
  return Astro.redirect('/musica/discografia');
}

// ✅ VARIABLES QUE FALTABAN:

// 1. artistNames (usado en línea 77)
const artistNames = release.artistIds?.map((artistId: string) => 
  artists.find(a => a.id === artistId)?.name
).filter(Boolean).join(', ') || 'Intérpretes no especificados';

// 2. releaseArtists (usado en líneas 156, 164, 198, 202)
const releaseArtists = release.artistIds?.map((artistId: string) => 
  artists.find(a => a.id === artistId)
).filter(Boolean) || [];

// 3. allGenres (usado en líneas 169, 171)
const allGenres = Array.isArray(release.genre) 
  ? release.genre 
  : release.genre 
    ? [release.genre] 
    : [];

// 4. descriptionParagraphs (usado en líneas 188, 190)
const descriptionParagraphs = release.descriptionLong 
  ? release.descriptionLong.split('\n\n') 
  : release.description 
    ? [release.description] 
    : [];

// 5. associatedMusicCard (usado en líneas 223, 229) - renombrado de associatedCards[0]
const associatedCards = musicCards.filter((card: any) => 
  card.associatedRelease === release.id
);
const associatedMusicCard = associatedCards[0] || null;

// 6. Navegación prevRelease/nextRelease (usado en líneas 268, 279)
const sortedReleases = [...releases].sort((a, b) => 
  new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime()
);
const currentIndex = sortedReleases.findIndex(r => r.id === id);
const prevRelease = currentIndex > 0 ? sortedReleases[currentIndex - 1] : null;
const nextRelease = currentIndex < sortedReleases.length - 1 ? sortedReleases[currentIndex + 1] : null;

// Breadcrumbs
const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Música', href: '/musica' },
  { label: 'Discografía', href: '/musica/discografia' },
  { label: release.workTitle || release.title, href: `/musica/discografia/${id}` },
];
---

<Layout 
  title={`${release.title} - Discografía`} 
  description={release.description || `Obra de ${artistNames} en DAG Klassical`}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto pt-8 px-4">
    <a href="/musica/discografia" class="text-slate-700 hover:text-dag-burgundy flex items-center text-sm">
      ← Volver a Discografía
    </a>
  </div>  
  <article class="max-w-4xl mx-auto px-4 pt-6 pb-10">
    <div class="flex flex-col md:flex-row gap-6">
      <div class="md:w-1/3">
        <img
          src={release.coverImage}
          alt={release.title}
          class="w-full rounded-md mx-auto shadow-md mt-4"
          onerror="this.src='https://placehold.co/300x300/cccccc/999999?text=Cover'"
        />
        <!-- Íconos de plataformas: justo debajo de la portada -->
{release.platforms && (
  <div class="mt-6 flex justify-center gap-4 flex-wrap">
    {release.platforms.spotify && (
      <a href={release.platforms.spotify} target="_blank" rel="noopener" aria-label="Spotify" class="block w-7 h-7 hover:scale-110 transition-transform">
        <img src="/icons/spotify-color-icon.svg" alt="Spotify" class="w-full h-full" />
      </a>
    )}
    {release.platforms.apple && (
      <a href={release.platforms.apple} target="_blank" rel="noopener" aria-label="Apple Music" class="block w-7 h-7 hover:scale-110 transition-transform">
        <img src="/icons/apple-music-color-icon.svg" alt="Apple Music" class="w-full h-full" />
      </a>
    )}
    {release.platforms.youtube && (
      <a href={release.platforms.youtube} target="_blank" rel="noopener" aria-label="YouTube Music" class="block w-7 h-7 hover:scale-110 transition-transform">
        <img src="/icons/youtube-music-color-icon.svg" alt="YouTube Music" class="w-full h-full" />
      </a>
    )}
    {release.platforms.tidal && (
      <a href={release.platforms.tidal} target="_blank" rel="noopener" aria-label="Tidal" class="block w-7 h-7 hover:scale-110 transition-transform">
        <img src="/icons/tidal-icon.svg" alt="Tidal" class="w-full h-full" />
      </a>
    )}
    {release.platforms.deezer && (
      <a href={release.platforms.deezer} target="_blank" rel="noopener" aria-label="Deezer" class="block w-7 h-7 hover:scale-110 transition-transform">
        <img src="/icons/deezer-color-icon.svg" alt="Deezer" class="w-full h-full" />
      </a>
    )}
  </div>
)}
        {release.tracks?.length > 0 && (
          <section class="mt-6 pt-4 border-t border-platinum">
            <h3 class="text-xl font-bold text-slate-700 mb-2">Tracklist</h3>
            <ol class="list-none space-y-0.5">
              {release.tracks.map((track, i) => (
                <li
                  class={`flex items-start py-1.5 px-2 rounded ${
                    i % 2 === 0 ? 'bg-white' : 'bg-gray95'
                  }`}
                >
                  <span 
                    class="text-slate-500 font-['Source_Code_Pro'] w-8 flex-shrink-0 text-right pr-2"
                    style="font-feature-settings: 'tnum';"
                  >
                    {i + 1}.
                  </span>
                  <span class="text-sm text-slate-700 flex-grow">{track.title}</span>
                  {track.duration && (
                    <span class="text-sm text-slate-500 opacity-80 ml-2 whitespace-nowrap">
                      ({track.duration})
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
      <div class="md:w-2/3">
        <h1 class="text-h1 font-advent mb-2">{release.title}</h1>
        <p class="text-xl text-slate-600 mb-2">
          por{' '}
          {releaseArtists.map((artist, i) => (
  <span>
    <a 
      href={`/musica/artistas/${artist?.id}`}   
      class="text-dag-burgundy hover:underline"
    >
      {artist?.name}  <!-- ✅ artist?.name -->
    </a>
    {i < releaseArtists.length - 1 && ', '}
  </span>
))}
        </p>

        {allGenres.length > 0 && (
  <div class="flex flex-wrap gap-1 my-2">
    {allGenres.map(genre => {
      const genreString = Array.isArray(genre) ? genre[0] : genre;
      return (
        <span
          class="text-xs bg-white text-slate-800 px-2 py-0.5 rounded border border-platinum font-medium"
        >
          {genreString.replace(/-/g, ' ')}
        </span>
      );
    })}
  </div>
)}

        <p class="text-slate-500 mb-4 text-sm">
          Lanzamiento • {new Date(release.releaseDate).toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric' })} • {release.type}
        </p>

        {descriptionParagraphs ? (
          <div class="mb-6 text-slate-700 space-y-3">
            {descriptionParagraphs.map(para => (
              <p>{para}</p>
            ))}
          </div>
        ) : release.description ? (
          <p class="mb-6 text-slate-700">{release.description}</p>
        ) : null}

        {releaseArtists.length > 1 && (
          <section class="mb-6">
            <h3 class="text-lg font-semibold mb-3">Artistas</h3>
            <div class="space-y-4">
              {releaseArtists.map(artist => (
                  <div class="border-l-2 border-dag-burgundy/30 pl-3">
                    <h4 class="font-medium">{artist?.name}</h4>  <!-- ✅ artist?.name -->
                  </div>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>

    <!-- ✅ Metadatos + CTA en dos columnas -->
    <div class="mt-8 pt-6 border-t border-platinum flex flex-col md:flex-row gap-6">
      <div class="md:w-1/3 p-4">
        <ImmutableStamp 
          uuid={release.metadata?.uuid || '—'}
          timestamp={release.metadata?.timestamp || '—'}
          operator={release.metadata?.operator || '—'}
        />
      </div>
      <div class="md:w-2/3 p-4 flex items-center justify-center">
        {associatedMusicCard ? (
          <div class="p-4 bg-white border border-platinum rounded text-center max-w-md w-full">
            <p class="text-slate-700 mb-3">
              Disponible este álbum en Music Card.
            </p>
            <a
              href={`/blockchain/music-cards/${associatedMusicCard.id}`}
              class="inline-block bg-dag-burgundy text-white px-4 py-2 rounded hover:bg-opacity-90 font-montserrat-bold"
            >
              Ver la Music Card
            </a>
          </div>
        ) : (
          <div class="bg-white border border-platinum rounded p-4 text-center max-w-md w-full">
            <p class="text-slate-700 mb-3">
              ¿Te gustaría una Music Card de esta obra?  
              Suscríbete para recibir novedades sobre "{release.title}".
            </p>
            <form 
              action="https://formspree.io/f/TU-FORM-ID" 
              method="POST"
              class="flex flex-col sm:flex-row gap-2 justify-center"
            >
              <input
                type="email"
                name="email"
                placeholder="tu@correo.com"
                class="px-3 py-2 border border-platinum rounded w-full sm:w-auto text-sm text-center sm:text-left"
                required
              />
              <input type="hidden" name="obra" value={release.title} />
              <input type="hidden" name="_subject" value={`Suscripción - Obra: ${release.title}`} />
              <button
                type="submit"
                class="bg-dag-burgundy text-white px-4 py-2 rounded hover:bg-opacity-90 font-montserrat-bold text-sm"
              >
                Suscríbete
              </button>
            </form>
          </div>
        )}
      </div>
    </div>

    <!-- ✅ Navegación Anterior/Siguiente entre releases -->
    {(prevRelease || nextRelease) && (
      <nav class="mt-12 pt-6 border-t border-platinum flex flex-col sm:flex-row justify-between gap-4">
        {prevRelease ? (
          <a 
            href={`/musica/discografia/${prevRelease.id}`} 
            class="flex items-center text-dag-burgundy hover:text-opacity-80 text-sm"
          >
            ← Anterior: {prevRelease.title}
          </a>
        ) : <div></div>}
        
        {nextRelease ? (
          <a 
            href={`/musica/discografia/${nextRelease.id}`} 
            class="flex items-center text-dag-burgundy hover:text-opacity-80 text-right text-sm"
          >
            Siguiente: {nextRelease.title} →
          </a>
        ) : <div></div>}
      </nav>
    )}
  </article>
</Layout>