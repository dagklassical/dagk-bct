---
// src/pages/musica/discografia/[id].astro
import Layout from '../../../layouts/Layout.astro';
import releases from '../../../data/releases.json';
import artists from '../../../data/artists.json';

// ✅ Prerrenderizar: discos están en el repo
export const prerender = true;

export async function getStaticPaths() {
  return releases.map(release => ({ params: { id: release.id } }));
}

const { id } = Astro.params;
const release = releases.find(r => r.id === id);

if (!release) {
  return Astro.redirect('/musica/discografia');
}

// Buscar todos los artistas asociados
const releaseArtists = release.artistIds.map(artistId => {
  return artists.find(a => a.id === artistId) || { id: artistId, name: artistId };
});

// Preprocesar redes y dominios de cada artista
const artistsWithSocial = releaseArtists.map(artist => {
  let websiteDomain = null;
  if (artist.website) {
    try {
      const url = new URL(artist.website);
      websiteDomain = url.hostname.replace('www.', '');
    } catch (e) {
      websiteDomain = artist.website;
    }
  }

  const socialLinks = artist.social 
    ? Object.entries(artist.social).map(([platform, url]) => {
        const name = platform.charAt(0).toUpperCase() + platform.slice(1);
        return { platform, url, name };
      })
    : [];

  return { ...artist, websiteDomain, socialLinks };
});

const artistNames = releaseArtists.map(a => a.name).join(', ');
const pageTitle = `${release.title} - Discografía`;
const pageDescription = release.description || `Detalles de la colección "${release.title}" por ${artistNames}.`;

// ✅ Procesar descriptionLong: dividir en párrafos si existen saltos de línea
const descriptionParagraphs = release.descriptionLong
  ? release.descriptionLong.split('\n\n').filter(p => p.trim() !== '')
  : null;

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Música', href: '/musica' },
  { label: 'Discografía', href: '/musica/discografia' },
  { label: release.title, href: `/musica/discografia/${id}` },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto pt-8 px-4">
    <a href="/musica/discografia" class="text-slate-700 hover:text-dag-burgundy flex items-center text-sm">
      ← Volver a Discografía
    </a>
  </div>  
  <article class="max-w-4xl mx-auto px-4 pt-6 pb-10">
    <div class="flex flex-col md:flex-row gap-6">
      <div class="md:w-1/3">
        <img
          src={release.coverImage}
          alt={release.title}
          class="w-full rounded-md mx-auto shadow-md mt-4"
          onerror="this.src='https://placehold.co/300x300/cccccc/999999?text=Cover'"
        />
{/* ✅ Tracklist debajo de la foto, con fondo cebra */}
{release.tracks?.length > 0 && (
  <section class="mt-6 pt-4 border-t border-platinum">
    <h3 class="text-xl font-bold text-slate-700 mb-2">Tracklist</h3>
    <ol class="list-none space-y-0.5">
      {release.tracks.map((track, i) => (
        <li
          key={i}
          class={`flex items-start py-1.5 px-2 rounded ${
            i % 2 === 0 ? 'bg-white' : 'bg-gray95'
          }`}
        >
          <span class="text-slate-500 font-mono w-6 flex-shrink-0">{i + 1}.</span>
          <span class="text-sm text-slate-700 flex-grow">{track.title}</span>
          {track.duration && (
            <span class="text-sm text-slate-500 opacity-80 ml-2">{track.duration}</span>
          )}
        </li>
      ))}
    </ol>
  </section>
)}
      </div>
      <div class="md:w-2/3">
        <h1 class="text-h1 font-advent mb-2">{release.title}</h1>
        <p class="text-xl text-slate-600 mb-2">
          por{' '}
          {artistsWithSocial.map((artist, i) => (
            <span key={artist.id}>
              <a 
                href={`/musica/artistas/${artist.id}`} 
                class="text-dag-burgundy hover:underline"
              >
                {artist.name}
              </a>
              {i < artistsWithSocial.length - 1 && ', '}
            </span>
          ))}
        </p>

        {/* ✅ Redes sociales como "tags" bajo el nombre */}
        {artistsWithSocial.some(a => a.socialLinks.length > 0) && (
          <div class="flex flex-wrap gap-1 my-2">
            {artistsWithSocial.flatMap(artist => 
              artist.socialLinks.map(({ platform, url, name }) => (
                <a
                  key={`${artist.id}-${platform}`}
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block bg-slate-100 hover:bg-dag-burgundy/10 text-slate-700 hover:text-dag-burgundy text-[10px] px-1.5 py-0.5 rounded"
                  aria-label={`Visitar ${name} de ${artist.name}`}
                >
                  {name}
                </a>
              ))
            )}
          </div>
        )}

        <p class="text-slate-500 mb-4 text-sm">
          {release.genre} • {new Date(release.releaseDate).toLocaleDateString('es-VE')} • {release.type}
        </p>

        {/* ✅ Mostrar descripción larga con párrafos, o corta como fallback */}
        {descriptionParagraphs ? (
          <div class="mb-6 text-slate-700 space-y-3">
            {descriptionParagraphs.map((para, i) => (
              <p key={i}>{para}</p>
            ))}
          </div>
        ) : release.description ? (
          <p class="mb-6 text-slate-700">{release.description}</p>
        ) : null}

        {/* === Información de artistas asociados (solo si hay más de uno o datos relevantes) === */}
        {artistsWithSocial.length > 1 && (
          <section class="mb-6">
            <h3 class="text-lg font-semibold mb-3">Artistas</h3>
            <div class="space-y-4">
              {artistsWithSocial.map(artist => (
                <div key={artist.id} class="border-l-2 border-dag-burgundy/30 pl-3">
                  <h4 class="font-medium">{artist.name}</h4>
                  
                  {/* Sitio web */}
                  {artist.websiteDomain && (
                    <p class="text-sm mt-1">
                      <a 
                        href={artist.website} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="text-dag-burgundy hover:underline"
                      >
                        {artist.websiteDomain}
                      </a>
                    </p>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <section>
          <h2 class="text-h2 font-advent mb-3">Music Cards Asociadas</h2>
          {release.musicCards?.length > 0 ? (
            <div class="space-y-2">
              {release.musicCards.map(cardId => (
                <a
                  key={cardId}
                  href={`/blockchain/music-cards/${cardId}`}
                  class="block bg-white p-3 rounded border border-platinum hover:bg-gray95 transition-colors"
                >
                  Ver Music Card: {cardId}
                </a>
              ))}
            </div>
          ) : (
            <p>No hay Music Cards asociadas a esta obra.</p>
          )}
        </section>
      </div>
    </div>

    <div class="mt-8 p-4 border-t border-platinum text-sm text-slate-600">
      <h3 class="font-semibold mb-2">Metadatos Inmutables</h3>
      <p><strong>UUID:</strong> {release.metadata?.uuid || '—'}</p>
      <p><strong>Timestamp:</strong> {release.metadata?.timestamp || '—'}</p>
      <p><strong>Operador:</strong> {release.metadata?.operator || '—'}</p>
    </div>
  </article>
</Layout>