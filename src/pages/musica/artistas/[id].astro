---
// src/pages/musica/artistas/[id].astro
import Layout from '../../../layouts/Layout.astro';
import ImmutableStamp from '../../../components/ImmutableStamp.astro';
import artists from '../../../data/artists.json';
import releases from '../../../data/releases.json';
import musicCards from '../../../data/music-cards.json';

export const prerender = true;

export async function getStaticPaths() {
  return artists.map(artist => ({ params: { id: artist.id } }));
}

const { id } = Astro.params;
const artist = artists.find(a => a.id === id);

if (!artist) {
  return Astro.redirect('/musica/artistas');
}

// === Navegación Anterior/Siguiente entre artistas ===
const currentIndex = artists.findIndex(a => a.id === id);
const prevArtist = currentIndex > 0 ? artists[currentIndex - 1] : null;
const nextArtist = currentIndex < artists.length - 1 ? artists[currentIndex + 1] : null;

// === Datos para el contenido ===
const artistReleases = releases.filter(r => r.artistIds?.includes(artist.id));
const artistMusicCards = musicCards.filter(card => 
  card.associatedRelease && 
  artistReleases.some(r => r.id === card.associatedRelease)
);

const socialLinks = artist.social 
  ? Object.entries(artist.social)
      .filter(([_, url]) => url && url.trim() !== '')
      .map(([platform, url]) => ({
        platform: platform.toLowerCase(),
        url: url.trim()
      }))
  : [];

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Música', href: '/musica' },
  { label: 'Artistas', href: '/musica/artistas' },
  { label: artist.name, href: `/musica/artistas/${id}` },
];
---

<Layout title={artist.name} description={artist.bio || `Perfil de ${artist.name} en DAG Klassical`} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto pt-8 px-4">
    <a href="/musica/artistas" class="text-slate-700 hover:text-dag-burgundy flex items-center text-sm">
      ← Volver a Artistas
    </a>
  </div>

  <article class="max-w-4xl mx-auto px-4 pt-6 pb-12">
    <div class="flex flex-col md:flex-row gap-8">
      <!-- Columna izquierda -->
      <div class="md:w-1/3">
        <img
          src={artist.avatar || '/images/placeholder-artist.webp'}
          alt={artist.name}
          class="w-full rounded-md shadow-md"
          onerror="this.src='/images/placeholder-artist.webp'"
        />

        <div class="mt-6 space-y-4">
          {artist.website && (
            <div>
              <h3 class="text-h3 font-advent mb-2 text-slate-900">Sitio web</h3>
              <a 
                href={artist.website} 
                target="_blank" 
                rel="noopener noreferrer"
                title={artist.website.replace('https://', '').replace('www.', '')}
                class="text-dag-burgundy hover:underline text-sm font-medium block truncate"
              >
                {artist.website.replace('https://', '').replace('www.', '')}
              </a>
            </div>
          )}

          {socialLinks.length > 0 && (
            <div>
              <h3 class="text-h3 font-advent mb-2 text-slate-900">Redes sociales</h3>
              <div class="flex flex-wrap gap-2">
                {socialLinks.map(({ platform, url }) => {
                  const iconPath = `/icons/${platform}.svg`;
                  return (
                    <a
                      key={platform}
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={platform.charAt(0).toUpperCase() + platform.slice(1)}
                      class="inline-flex items-center justify-center w-8 h-8 bg-white hover:bg-dag-burgundy/10 text-slate-700 hover:text-dag-burgundy rounded-full border border-platinum"
                    >
                      <img 
                        src={iconPath} 
                        alt={platform} 
                        class="w-4 h-4"
                        onerror="this.src='/icons/default.svg'"
                      />
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          {artistReleases.length > 0 && (
            <div class="mt-6">
              <h3 class="text-h3 font-advent mb-4 text-slate-900">Obras en DAG Klassical</h3>
              <ul class="space-y-3">
                {artistReleases.map(release => (
                  <li key={release.id}>
                    <a 
                      href={`/musica/discografia/${release.id}`} 
                      class="text-slate-900 hover:text-dag-burgundy text-lg font-medium"
                    >
                      {release.workTitle || release.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>

      <!-- Columna derecha -->
      <div class="md:w-2/3">
        <h1 class="text-h1 font-advent mb-2">{artist.name}</h1>
        
        {artist.role && (
          <p class="text-xl text-slate-600 mb-6">{artist.role}</p>
        )}

        {artist.bioLong ? (
          <div class="text-slate-700 space-y-4">
            {artist.bioLong.split('\n\n').map((para, i) => (
              <p key={i}>{para}</p>
            ))}
          </div>
        ) : artist.bio ? (
          <p class="text-slate-700">{artist.bio}</p>
        ) : null}
      </div>
    </div>

    <!-- ✅ Metadatos + CTA en dos columnas -->
    <div class="mt-10 pt-8 border-t border-platinum flex flex-col md:flex-row gap-6">
      <div class="md:w-1/3 p-4">
        <ImmutableStamp 
          uuid={artist.metadata?.uuid || '—'}
          timestamp={artist.metadata?.timestamp || '—'}
          operator={artist.metadata?.operator || '—'}
        />
      </div>
      <div class="md:w-2/3 p-4 flex items-center justify-center">
        {artistMusicCards.length > 0 ? (
          <div class="p-4 bg-white border border-platinum rounded text-center max-w-md w-full">
            <p class="text-slate-700 mb-3">
              Explora las Music Cards de {artist.name} en DAG Klassical.
            </p>
            <a
              href={`/blockchain/music-cards/artistas/${artist.id}`}
              class="inline-block bg-dag-burgundy text-white px-5 py-2.5 rounded hover:bg-opacity-90 font-montserrat-bold"
            >
              Colecciones de {artist.name.split(' ')[0]}
            </a>
          </div>
        ) : (
          <div class="bg-white border border-platinum rounded p-4 text-center max-w-md w-full">
            <p class="text-slate-700 mb-3">
              ¿Interesado en la música de {artist.name}?
            </p>
            <p class="text-slate-700 mb-4">
              {artist.name.split(' ')[0]} aún no cuenta con Music Cards en DAG Klassical. 
              Si nos brindas tu correo podremos avisarte una vez disponibles.
            </p>
            <form 
              action="https://formspree.io/f/TU-FORM-ID" 
              method="POST"
              class="flex flex-col sm:flex-row gap-3 justify-center"
            >
              <input
                type="email"
                name="email"
                placeholder="tu@correo.com"
                class="px-4 py-2.5 border border-platinum rounded w-full sm:w-auto font-montserrat text-center sm:text-left"
                required
              />
              <input type="hidden" name="artist" value={artist.name} />
              <input type="hidden" name="_subject" value={`Suscripción - Artista: ${artist.name}`} />
              <button
                type="submit"
                class="bg-dag-burgundy text-white px-5 py-2.5 rounded hover:bg-opacity-90 font-montserrat-bold"
              >
                Suscríbete
              </button>
            </form>
          </div>
        )}
      </div>
    </div>

    <!-- ✅ Navegación Anterior/Siguiente entre artistas -->
    {(prevArtist || nextArtist) && (
      <nav class="mt-12 pt-6 border-t border-platinum flex flex-col sm:flex-row justify-between gap-4">
        {prevArtist ? (
          <a 
            href={`/musica/artistas/${prevArtist.id}`} 
            class="flex items-center text-dag-burgundy hover:text-opacity-80 selection:text-sm"
          >
            ← Anterior: {prevArtist.name}
          </a>
        ) : <div></div>}
        
        {nextArtist ? (
          <a 
            href={`/musica/artistas/${nextArtist.id}`} 
            class="flex items-center text-dag-burgundy hover:text-opacity-80 text-right text-sm"
          >
            Siguiente: {nextArtist.name} →
          </a>
        ) : <div></div>}
      </nav>
    )}
  </article>
</Layout>