---
// src/pages/musica/artistas/[id].astro
import Layout from '../../../layouts/Layout.astro';
import ImmutableStamp from '../../../components/ImmutableStamp.astro';
import artists from '../../../data/artists.json';
import releases from '../../../data/releases.json';

// ✅ Prerrenderizar porque los artistas están en el repo
export const prerender = true;

export async function getStaticPaths() {
  return artists.map(artist => ({ params: { id: artist.id } }));
}

const { id } = Astro.params;
const artist = artists.find(a => a.id === id);

if (!artist) {
  return Astro.redirect('/musica/artistas');
}

const artistReleases = releases.filter(r => 
  Array.isArray(artist.releases) && artist.releases.includes(r.id)
);

// ✅ Extraer dominio del sitio web (seguro)
let websiteDomain = null;
if (artist.website) {
  try {
    const url = new URL(artist.website);
    websiteDomain = url.hostname.replace('www.', '');
  } catch (e) {
    websiteDomain = artist.website;
  }
}

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Música', href: '/musica' },
  { label: 'Artistas', href: '/musica/artistas' },
  { label: artist.name, href: `/musica/artistas/${id}` },
];
---

<Layout title={artist.name} description={artist.bio || `Perfil de ${artist.name}`} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto pt-8 px-4">
    <a href="/musica/artistas" class="text-slate-700 hover:text-dag-burgundy flex items-center text-sm">
      ← Volver a Artistas
    </a>
  </div>

  <article class="max-w-4xl mx-auto px-4 pt-6 pb-10">
    <div class="flex flex-col md:flex-row gap-6">
      <div class="md:w-1/3 text-center">
        <img
          src={artist.avatar}
          alt={artist.name}
          class="w-80 h-100 rounded-md mx-auto shadow-md object-cover mt-4"
          onerror="this.src='https://placehold.co/200x200/cccccc/999999?text=Avatar'"
        />

        {/* ✅ Sitio web y redes sociales bajo la foto */}
        <div class="mt-6 pt-4 border-t border-platinum text-left">
          {websiteDomain && (
            <p class="mb-3">
              <strong class="text-slate-700">Sitio web:</strong><br />
              <a 
                href={artist.website} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-dag-burgundy hover:underline font-medium"
              >
                {websiteDomain}
              </a>
            </p>
          )}

          {artist.social && (
            <div>
              <strong class="text-slate-700">Redes sociales:</strong>
              <div class="flex flex-wrap gap-2 mt-2">
                {Object.entries(artist.social).map(([platform, url]) => {
                  const platformName = platform.charAt(0).toUpperCase() + platform.slice(1);
                  return (
                    <a
                      key={platform}
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 bg-white border border-platinum hover:bg-dag-burgundy/5 px-2 py-1 rounded text-xs text-slate-700 hover:text-dag-burgundy transition-colors"
                      aria-label={`Visitar ${platformName} de ${artist.name}`}
                    >
                      {platformName}
                    </a>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="md:w-2/3">
        <h1 class="text-h1 font-advent mb-2">{artist.name}</h1>
        <p class="text-xl text-slate-600 mb-4">{artist.role}</p>

        {/* ✅ Mostrar bioLong con párrafos, o bio como fallback */}
        {artist.bioLong ? (
          <div class="mb-6 text-slate-700 space-y-3">
            {artist.bioLong
              .split('\n\n')
              .filter(p => p.trim() !== '')
              .map((para, i) => (
                <p key={i}>{para}</p>
              ))}
          </div>
        ) : artist.bio ? (
          <p class="mb-6 text-slate-700">{artist.bio}</p>
        ) : null}

        <section>
          <h2 class="text-xl font-semibold mb-3">Obras asociadas</h2>
          {artistReleases.length > 0 ? (
            <div class="space-y-2">
              {artistReleases.map(release => (
                <a
                  key={release.id}
                  href={`/musica/discografia/${release.id}`}
                  class="block bg-white p-3 rounded border border-platinum hover:bg-gray95 transition-colors"
                >
                  {release.title} ({release.type})
                </a>
              ))}
            </div>
          ) : (
            <p>No hay obras asociadas a este artista aún.</p>
          )}
        </section>
      </div>
    </div>
  </article>
</Layout>