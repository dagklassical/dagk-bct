---
// src/pages/musica/artistas/[id].astro
import Layout from '../../../layouts/Layout.astro';
import artists from '../../../data/artists.json';
import releases from '../../../data/releases.json';
import musicCards from '../../../data/music-cards.json';

export const prerender = true;

export async function getStaticPaths() {
  return artists.map(artist => ({ params: { id: artist.id } }));
}

const { id } = Astro.params;
const artist = artists.find(a => a.id === id);

if (!artist) {
  return Astro.redirect('/musica/artistas');
}

// Obtener releases asociados
const artistReleases = releases.filter(r => 
  r.artistIds?.includes(artist.id)
);

// Obtener Music Cards del artista
const artistMusicCards = musicCards.filter(card => 
  card.artistIds?.includes(artist.id) || 
  (artist.musicCards && artist.musicCards.includes(card.id))
);

// Preprocesar redes sociales
const socialLinks = artist.social 
  ? Object.entries(artist.social)
      .filter(([_, url]) => url && url.trim() !== '')
      .map(([platform, url]) => {
        const cleanUrl = url.trim();
        let domain = cleanUrl;
        try {
          const urlObj = new URL(cleanUrl);
          domain = urlObj.hostname.replace('www.', '');
        } catch {}
        return { platform, url: cleanUrl, domain };
      })
  : [];

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Música', href: '/musica' },
  { label: 'Artistas', href: '/musica/artistas' },
  { label: artist.name, href: `/musica/artistas/${id}` },
];
---

<Layout title={artist.name} description={artist.bio || `Perfil de ${artist.name} en DAG Klassical`} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto pt-8 px-4">
    <a href="/musica/artistas" class="text-slate-700 hover:text-dag-burgundy flex items-center text-sm">
      ← Volver a Artistas
    </a>
  </div>

  <article class="max-w-4xl mx-auto px-4 pt-6 pb-12">
    <div class="flex flex-col md:flex-row gap-8">
      <!-- Columna izquierda: foto, redes, y LISTA DE OBRAS -->
      <div class="md:w-1/3 space-y-6">
        <img
          src={artist.avatar || '/images/placeholder-artist.webp'}
          alt={artist.name}
          class="w-full rounded-md shadow-md"
          onerror="this.src='https://placehold.co/300x300/cccccc/999999?text=Artista'"
        />

        {/* Información de contacto y redes */}
        <div class="space-y-4">
          {artist.website && (
            <div>
              <p class="text-base  text-slate-600">Sitio web</p>
              <a 
                href={artist.website} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-dag-burgundy hover:underline text-sm font-medium"
              >
                {artist.website.replace('https://', '').replace('www.', '')}
              </a>
            </div>
          )}

          {socialLinks.length > 0 && (
            <div>
              <p class="text-base text-slate-600 mb-2">Redes sociales</p>
              <div class="flex flex-wrap gap-1">
                {socialLinks.map(({ platform, url, domain }) => (
                  <a
                    key={platform}
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block bg-white hover:bg-dag-burgundy/10 text-slate-700 hover:text-dag-burgundy text-[10px] px-1.5 py-0.5 rounded border border-platinum"
                  >
                    {platform}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* LISTA DE OBRAS aquí, en la columna izquierda */}
        {artistReleases.length > 0 && (
          <section>
            <h3 class="text-lg font-semibold mb-3 text-slate-900">Obras en DAG Klassical</h3>
            <ul class="space-y-3">
              {artistReleases.map(release => (
                <li key={release.id}>
                  <a 
                    href={`/musica/discografia/${release.id}`} 
                    class="text-sm text-slate-700 hover:text-dag-burgundy font-medium block"
                  >
                    {release.workTitle || release.title}
                  </a>
                  {release.composer && (
                    <span class="text-[10px] text-slate-500 block mt-0.5">
                      Obra de {release.composer}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <!-- Columna derecha: título y biografía -->
      <div class="md:w-2/3">
        <h1 class="text-h1 font-advent mb-2">{artist.name}</h1>
        
        {artist.role && (
          <p class="text-xl text-slate-600 mb-6">{artist.role}</p>
        )}

        {artist.bioLong ? (
          <div class="text-slate-700 space-y-4">
            {artist.bioLong.split('\n\n').map((para, i) => (
              <p key={i}>{para}</p>
            ))}
          </div>
        ) : artist.bio ? (
          <p class="text-slate-700">{artist.bio}</p>
        ) : null}
      </div>
    </div>

    <!-- CTA de Music Cards (fuera de las columnas) -->
    {artistMusicCards.length > 0 && (
      <section class="mt-12 pt-8 border-t border-platinum">
        <h2 class="text-h2 font-advent mb-4">Colecciones Disponibles</h2>
        <p class="text-slate-700 mb-6">
          Algunas obras de {artist.name} están disponibles como Music Cards: 
          activos digitales certificados en blockchain con beneficios exclusivos.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {artistMusicCards.map(card => (
            <a
              key={card.id}
              href={`/blockchain/music-cards/${card.id}`}
              class="block bg-white p-4 rounded-lg border border-platinum hover:bg-gray95 transition-colors"
            >
              <h3 class="font-semibold text-slate-900">{card.title}</h3>
              <p class="text-sm text-dag-burgundy mt-1">{card.edition}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>