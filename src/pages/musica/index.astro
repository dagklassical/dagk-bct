---
// src/pages/musica/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SectionHeader from '../../components/SectionHeader.astro';

// ✅ Content Collections (tipado correcto)
const allArtists = await getCollection('artists');
const allMusicCards = await getCollection('music-cards');
const allNoticias = await getCollection('noticias');

// Procesar datos
const artists = allArtists.map(a => a.data);

const musicCards = allMusicCards.map(m => m.data);
const latestReleases = musicCards
  .filter(card => card.status === 'disponible' || card.status === 'próximo')
  .slice(0, 6);

const latestNews = allNoticias
  .filter(post => {
    const d = new Date(post.data.date);
    return d instanceof Date && !isNaN(d.getTime());
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Música', href: '/musica' },
];
---

<Layout 
  title="Música | DAG Klassical" 
  description="El corazón de DAG Klassical. Explora artistas, lanzamientos y novedades del ecosistema musical." 
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <header class="bg-white text-center mb-12 py-10 px-4">
    <h1 class="text-h1 font-advent">El Corazón de la Música Clásica Digital</h1>
    <p class="text-dag-burgundy max-w-4xl mx-auto mt-3 md:max-w-5xl">
      Conoce a los artistas detrás de cada nota y descubre las novedades de nuestro ecosistema.
    </p>
  </header>

  <main class="bg-gray95">

    <!-- ===================================
         1. ARTISTAS → Carousel full-width
         =================================== -->
    <section class="w-full overflow-hidden px-4 py-8 bg-platinum">
      <div class="text-center mb-6">
        <h3 class="text-xl md:text-2xl font-advent font-medium text-slate-800 max-w-3xl mx-auto">
          Artistas que dan vida a cada obra.
        </h3>
      </div>
      
      <div class="flex overflow-x-auto pb-4 -mx-2 hide-scrollbar">
        {artists.map((artist) => (
          <div class="flex-shrink-0 px-2 w-48">
            <a href={`/musica/artistas/${artist.id}`} class="block text-center group">
              <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden">
                <div class="aspect-[4/5]">
                  {artist.avatar ? (
                    <img 
                      src={artist.avatar} 
                      alt={artist.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      onerror="this.src='/images/artists/300x400.svg'"
                    />
                  ) : (
                    <img 
                      src="/images/artists/300x400.svg" 
                      alt={artist.name}
                      class="w-full h-full object-cover opacity-50"
                      loading="lazy"
                    />
                  )}
                </div>
              </div>
              <h3 class="mt-3 font-semibold text-slate-800 group-hover:text-dag-burgundy transition-colors text-sm">
                {artist.name}
              </h3>
            </a>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-6">
        <a href="/musica/artistas" class="btn-primary inline-block px-6 py-3">
          Explorar Todos los Artistas
        </a>
      </div>
    </section>

    <!-- ===================================
         2. CANVAS PRINCIPAL: Music Cards
         =================================== -->
    <div class="max-w-6xl mx-auto px-4 py-12">

      <section class="mb-20">
        <div class="text-center mb-10">
          <h3 class="text-xl md:text-2xl font-advent font-medium text-slate-800 max-w-3xl mx-auto">
            Colecciones únicas con autenticidad digital y acceso exclusivo.
          </h3>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5">
          {latestReleases.map((card) => (
            <a 
              href={`/blockchain/music-cards/${card.id}`} 
              class="group block bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden"
            >
              <div class="aspect-[5/8]">
                <img 
                  src={card.cardImage || '/images/placeholder-card.jpg'} 
                  alt={card.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-3">
                <h4 class="text-sm font-bold font-advent text-slate-900 group-hover:text-dag-burgundy truncate">
                  {card.title}
                </h4>
                <p class="text-xs text-slate-500 truncate mt-1">
                  {card.artist || 'Artista'}
                </p>
              </div>
            </a>
          ))}
        </div>
        
        <div class="text-center mt-8">
          <a href="/blockchain/music-cards" class="btn-primary inline-block px-6 py-3">
            Explorar Music Cards
          </a>
        </div>
      </section>

    </div> <!-- Cierre del canvas max-w-6xl -->

    <!-- ===================================
         3. NOTICIAS → Al final, fondo distinto
         =================================== -->
    <section class="bg-platinum py-16">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-10">
          <h3 class="text-xl md:text-2xl font-advent font-medium text-slate-800 max-w-3xl mx-auto">
            Mantente al día con el pulso de la revolución musical.
          </h3>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          {latestNews.map((post) => (
            <article class="bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden">
              <a href={`/noticias/${post.slug}`} class="block">
                <img 
                  src={post.data.image || '/images/placeholder-news.jpg'} 
                  alt={post.data.title}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
                <div class="p-5">
                  <span class="inline-block px-3 py-1 text-xs font-semibold text-dag-burgundy bg-dag-burgundy/10 rounded-full mb-3">
                    {post.data.tags?.[0] || 'General'}
                  </span>
                  <h4 class="text-lg font-bold font-advent text-slate-900 mb-2 line-clamp-2">
                    {post.data.title}
                  </h4>
                  <p class="text-sm text-slate-500">
                    {new Date(post.data.date).toLocaleDateString('es-VE', { 
                      day: 'numeric', 
                      month: 'long', 
                      year: 'numeric' 
                    })}
                  </p>
                </div>
              </a>
            </article>
          ))}
        </div>
        
        <div class="text-center mt-8">
          <a href="/noticias" class="btn-secondary inline-block px-6 py-3">
            Ver Todas las Noticias
          </a>
        </div>
      </div>
    </section>

  </main>

  <style>
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
  </style>
</Layout>