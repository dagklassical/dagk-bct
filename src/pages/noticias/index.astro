---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Noticias', href: '/noticias' },
];

const pageTitle = 'Noticias | DAG Klassical';
const pageDescription = 'Lanzamientos, artistas y tecnología blockchain en la música clásica.';

const allNoticias = await getCollection('noticias');

const allTags = [...new Set(
  allNoticias
    .flatMap(post => post.data.tags || [])
    .filter(tag => typeof tag === 'string' && tag.trim() !== '')
)];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <main class="bg-gray95">
    <div class="max-w-6xl mx-auto px-4 py-10 space-y-10">

      <!-- Hero -->
      <section class="text-center">
        <h1 class="text-h1 md:text-6xl font-advent font-bold text-slate-900 mb-4">
          Noticias y Novedades
        </h1>
        <p class="text-lg md:text-2xl text-slate-600 max-w-4xl mx-auto">
          Lanzamientos, eventos y tecnología en un solo lugar.
        </p>
      </section>

      <!-- Nube de etiquetas -->
      <section class="bg-white/60 p-6 rounded-mg shadow-sm">
        <div class="flex flex-wrap gap-2 justify-center">
          <button data-tag="todos" class="tag-btn px-2 py-1 text-xs font-medium rounded-sm border border-dag-burgundy bg-dag-burgundy text-white transition-all">
            Todas
          </button>
          {allTags.map((tag) => (
            <button 
              data-tag={tag} 
              class="tag-btn px-2 py-1 text-xs font-medium rounded-sm border border-platinum bg-white text-slate-700 hover:bg-dag-burgundy/10 hover:text-dag-burgundy transition-all"
            >
              {tag}
            </button>
          ))}
        </div>
      </section>

      <!-- Grid con altura variable, orden cronológico respetado -->
<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
  {allNoticias
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()) // más reciente primero
    .map((post) => {
      const cleanTags = (post.data.tags || []).filter(t => t).join(' ') || '';
      return <article 
        class="news-card bg-white rounded-xl shadow-md hover:shadow-lg transition-all duration-300 overflow-hidden border border-platinum/30"
        data-title={post.data.title || ''}
        data-summary={post.data.summary || ''}
        data-tags={(post.data.tags || []).map(t => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '')).join(' ') || ''}
      >
        <a href={`/noticias/${post.slug}`} class="block h-full">
          <div class="relative h-48 overflow-hidden">
            <img 
              src={post.data.image || '/images/placeholder.jpg'} 
              alt={post.data.title || 'Noticia'} 
              class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" 
            />
            <div class="absolute top-3 right-3">
              <span class="px-2 py-1 text-xs font-medium text-dag-burgundy border border-dag-burgundy/30 bg-white rounded-sm whitespace-nowrap">
                {(post.data.tags && post.data.tags[0]) ? post.data.tags[0] : 'General'}
              </span>
            </div>
          </div>
          <div class="p-5 flex flex-col h-full">
            <h3 class="text-xl font-bold font-advent text-slate-900 mb-2 hover:text-dag-burgundy transition-colors">
              {post.data.title}
            </h3>
            <p class="text-sm text-slate-500 mb-3">
              {new Date(post.data.date).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
            <p class="text-slate-600 text-base mb-4 flex-grow">
              {post.data.summary || 'Leer más sobre esta noticia'}
            </p>
            <div class="mt-auto pt-3 border-t border-platinum/20">
              <span class="inline-flex items-center text-dag-burgundy font-medium text-sm hover:underline">
                Leer más
                <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </a>
      </article>;
    })}
</section>

      <!-- Script de filtrado -->
      <script>
  document.addEventListener('DOMContentLoaded', function() {
    var tagButtons = document.querySelectorAll('[data-tag]');
    var newsCards = document.querySelectorAll('.news-card');

    function normalize(str: string): string {
      return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    }

    function applyTagFilter(selectedTag: string) {
      var normSelected = normalize(selectedTag);
      tagButtons.forEach(function(btn) {
        var htmlBtn = btn as HTMLElement;
        var isActive = htmlBtn.dataset.tag === selectedTag;
        if (isActive) {
          htmlBtn.className = 'tag-btn px-2 py-1 text-xs font-medium rounded-sm border border-dag-burgundy bg-dag-burgundy text-white transition-all';
        } else {
          htmlBtn.className = 'tag-btn px-2 py-1 text-xs font-medium rounded-sm border border-platinum bg-white text-slate-700 hover:bg-dag-burgundy/10 hover:text-dag-burgundy transition-all';
        }
      });
      newsCards.forEach(function(card) {
        var htmlCard = card as HTMLElement;
        var tags = (htmlCard.dataset.tags || '').split(' ');
        var show = selectedTag === 'todos' || tags.some(function(t: string) {
          return normalize(t) === normSelected;
        });
        htmlCard.style.display = show ? 'block' : 'none';
      });
    }

    tagButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var htmlBtn = btn as HTMLElement;
        applyTagFilter(htmlBtn.dataset.tag || 'todos');
      });
    });
  });
</script>
    </div>
  </main>
</Layout>