---
import Layout from '../../../layouts/Layout.astro';
import { default as VelvetDashboardWrapper } from '../../../components/velvet/DashboardWrapper.tsx';
---

<Layout title="Dashboard Privado - DAG KLASSICAL">
  <div class="min-h-screen bg-dag-black py-12 px-6">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-3xl font-bold text-white text-center mb-8 uppercase tracking-wide">Mi Espacio Privado</h1>
      
      <!-- Isla React protegida por Middleware + Enrutador de Rol -->
      <VelvetDashboardWrapper client:load />
    </div>
  </div>
</Layout>