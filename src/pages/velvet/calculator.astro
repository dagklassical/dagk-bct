---
// Página pública oculta: /velvet/calculator
// No enlazar desde menú. Solo acceso directo para demo.

import Layout from '../../layouts/Layout.astro';
import VelvetCalculator from '../../components/velvet/Calculator';

const title = 'Calculadora Music Card - DAG KLASSICAL';
const description = 'Calcula el valor de reventa de tu Music Card basado en seguidores sociales.';
---

<Layout title={title} description={description}>
  <!-- ✅ Fondo cambiado de bg-dag-black a bg-gray95 (#f2f2f2) -->
  <div class="min-h-screen bg-gray95 py-8 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Header mínimo -->
      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold text-dag-burgundy uppercase tracking-wide">
          Calculadora de Valoración
        </h1>
        <p class="text-gray-600 text-sm mt-1">El valor de reventa de tu Music Card basado en seguidores sociales</p>
      </div>
      
      <!-- Isla React: Calculadora funcional -->
      <VelvetCalculator client:load />
      
      <!-- Footer mínimo -->
      <div class="text-center mt-8 text-xs text-gray-500">
        <p>DAG KLASSICAL © 2026</p>
      </div>
    </div>
  </div>
</Layout>