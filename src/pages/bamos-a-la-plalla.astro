---
// src/pages/bamos-a-la-plalla.astro
// Página segura para generación de JSON de artistas
// Acceso: /bamos-a-la-plalla
// Frase secreta: hermano-acuerdate-de-mi

const ACCESS_PHRASE = "hermano-acuerdate-de-mi";
let formData = null;
let jsonOutput = null;
let fileName = "";
let avatarPath = "";
let generatedUuid = "";

// Solo procesamos si es POST
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const phrase = data.get('accessPhrase');

  if (phrase === ACCESS_PHRASE) {
    // Extracción de datos
    const name = data.get('name')?.toString().trim() || '';
    const slug = name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    
    // Generación de UUID y Timestamp
    const uuid = `urn:uuid:${crypto.randomUUID()}`;
    const timestamp = new Date().toISOString();

    // Preparación del objeto JSON
    const artistData = {
      id: slug,
      name: name,
      role: data.get('role')?.toString().trim() || '',
      country: data.get('country')?.toString().trim() || 'Venezuela',
      city: data.get('city')?.toString().trim() || '',
      genre: data.get('genre')?.toString().split(',').map(g => g.trim()).filter(g => g) || [],
      bio: data.get('bio')?.toString().trim() || '',
      bioLong: data.get('bioLong')?.toString().trim() || '',
      avatar: `/artists/profile-${slug}.webp`, // Ruta automática
      website: data.get('website')?.toString().trim() || '',
      social: {
        instagram: data.get('instagram')?.toString().trim() || '',
        youtube: data.get('youtube')?.toString().trim() || '',
        facebook: data.get('facebook')?.toString().trim() || ''
      },
      releases: [], // Se llenan manualmente luego
      musicCards: [], // Se llenan manualmente luego
      metadata: {
        uuid: uuid,
        timestamp: timestamp,
        operator: "ceo@dagklassical.com"
      },
      tagline: data.get('tagline')?.toString().trim() || ''
    };

    // Asignar a variables para pasar al frontend
    formData = artistData;
    jsonOutput = JSON.stringify(artistData, null, 2);
    fileName = `${slug}.json`;
    avatarPath = `/artists/profile-${slug}.webp`;
    generatedUuid = uuid;
  } else {
    // Si la frase está mal, no hacemos nada (o podríamos mostrar error)
    // Para seguridad, simplemente no mostramos el resultado
  }
}
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Editor de Artistas - DAG Klassical</title>
  <style>
    :root {
      --bg: #f8f9fa;
      --text: #333;
      --primary: #800020; /* Dag Burgundy */
      --primary-hover: #5a0016;
      --border: #e2e8f0;
      --white: #ffffff;
    }
    body { font-family: system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; margin: 0; padding: 2rem; }
    .container { max-width: 800px; margin: 0 auto; background: var(--white); padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    h1 { color: var(--primary); text-align: center; margin-bottom: 2rem; }
    .form-group { margin-bottom: 1.5rem; }
    label { display: block; font-weight: 600; margin-bottom: 0.5rem; color: #4a5568; }
    input[type="text"], input[type="url"], input[type="email"], textarea, select {
      width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 6px; font-size: 1rem; box-sizing: border-box;
    }
    textarea { min-height: 120px; resize: vertical; }
    .hint { font-size: 0.875rem; color: #718096; margin-top: 0.25rem; }
    button {
      background: var(--primary); color: white; border: none; padding: 0.75rem 1.5rem; font-size: 1rem; font-weight: bold; border-radius: 6px; cursor: pointer; transition: background 0.2s; width: 100%;
    }
    button:hover { background: var(--primary-hover); }
    button.secondary { background: #4a5568; margin-top: 1rem; }
    button.secondary:hover { background: #2d3748; }
    
    .login-section { text-align: center; max-width: 400px; margin: 4rem auto; }
    .hidden { display: none; }
    
    .result-box {
      margin-top: 2rem; padding: 1.5rem; background: #edf2f7; border-radius: 8px; border: 1px solid var(--border);
    }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; font-size: 0.9rem; }
    .info-item strong { color: var(--primary); }
    pre { background: #1a202c; color: #68d391; padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 0.85rem; position: relative; }
    
    .copy-btn {
      position: absolute; top: 0.5rem; right: 0.5rem; background: rgba(255,255,255,0.2); color: white; border: none; padding: 0.25rem 0.5rem; font-size: 0.75rem; border-radius: 4px; cursor: pointer; width: auto;
    }
    .copy-btn:hover { background: rgba(255,255,255,0.4); }

    .password-wrapper { position: relative; display: flex; align-items: center; }
    .password-wrapper input { padding-right: 3rem; }
    .toggle-pw {
      position: absolute; right: 0.5rem; background: none; border: none; color: #718096; cursor: pointer; font-size: 0.8rem; width: auto; padding: 0;
    }
    .toggle-pw:hover { color: var(--primary); }
  </style>
</head>
<body>

<div class="container">
  <h1>🎵 Nuevo Perfil de Artista</h1>

  <!-- FORMULARIO -->
  <form id="artistForm" method="POST">
    
    <!-- Seguridad -->
    <div class="form-group">
      <label for="accessPhrase">Frase de Autorización</label>
      <div class="password-wrapper">
        <input type="password" id="accessPhrase" name="accessPhrase" required placeholder="Ingresa la frase secreta">
        <button type="button" class="toggle-pw" onclick="togglePassword()">👁️</button>
      </div>
      <p class="hint">Requerida para generar el archivo.</p>
    </div>

    <hr style="border: 0; border-top: 1px solid var(--border); margin: 2rem 0;">

    <!-- Datos Principales -->
    <div class="form-group">
      <label for="name">Nombre Completo del Artista</label>
      <input type="text" id="name" name="name" required placeholder="Ej: Gerardo Gerulewicz" oninput="updatePreview()">
      <p class="hint">Se usará para generar el ID y el nombre del archivo.</p>
    </div>

    <div class="form-group">
      <label for="role">Rol Principal</label>
      <input type="text" id="role" name="role" required placeholder="Ej: Pianista, Compositor">
    </div>

    <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div>
        <label for="country">País</label>
        <input type="text" id="country" name="country" value="Venezuela">
      </div>
      <div>
        <label for="city">Ciudad</label>
        <input type="text" id="city" name="city" placeholder="Ej: Caracas">
      </div>
    </div>

    <div class="form-group">
      <label for="genre">Géneros (separados por coma)</label>
      <input type="text" id="genre" name="genre" placeholder="Ej: música-navideña, piano-clásico">
    </div>

    <div class="form-group">
      <label for="tagline">Frase Corta / Tagline</label>
      <input type="text" id="tagline" name="tagline" placeholder="Ej: La arquitectura del sonido">
    </div>

    <!-- Biografías -->
    <div class="form-group">
      <label for="bio">Biografía Corta (Resumen)</label>
      <textarea id="bio" name="bio" required placeholder="1-2 párrafos breves para tarjetas y listas."></textarea>
    </div>

    <div class="form-group">
      <label for="bioLong">Biografía Larga (Completa)</label>
      <textarea id="bioLong" name="bioLong" required placeholder="Biografía completa. Usa doble 'Enter' para separar párrafos." style="min-height: 200px;"></textarea>
      <p class="hint">El formato de párrafos se conservará automáticamente.</p>
    </div>

    <!-- Redes y Web -->
    <div class="form-group">
      <label for="website">Sitio Web Oficial</label>
      <input type="url" id="website" name="website" placeholder="https://...">
    </div>

    <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
      <div>
        <label for="instagram">Instagram URL</label>
        <input type="url" id="instagram" name="instagram" placeholder="https://instagram.com/...">
      </div>
      <div>
        <label for="youtube">YouTube URL</label>
        <input type="url" id="youtube" name="youtube" placeholder="https://youtube.com/...">
      </div>
      <div>
        <label for="facebook">Facebook URL</label>
        <input type="url" id="facebook" name="facebook" placeholder="https://facebook.com/...">
      </div>
    </div>

    <button type="submit">🔐 Verificar y Generar JSON</button>
  </form>

  <!-- RESULTADOS (Solo visible tras éxito) -->
  {formData && (
    <div class="result-box">
      <h2 style="color: var(--primary); margin-top: 0;">✅ Archivo Generado Exitosamente</h2>
      
      <div class="info-grid">
        <div class="info-item"><strong>Archivo:</strong> {fileName}</div>
        <div class="info-item"><strong>UUID:</strong> {generatedUuid}</div>
        <div class="info-item"><strong>Avatar Ruta:</strong> {avatarPath}</div>
        <div class="info-item"><strong>ID Interno:</strong> {formData.id}</div>
      </div>

      <p class="hint" style="margin-bottom: 1rem;">
        1. Descarga el archivo.<br>
        2. Sube la foto del artista a tu VPS como <code>{avatarPath}</code>.<br>
        3. Envía el JSON al desarrollador.
      </p>

      <pre id="jsonOutput"><button class="copy-btn" onclick="copyToClipboard()">Copiar</button>{jsonOutput}</pre>
      
      <a 
        href={'data:application/json;charset=utf-8,' + encodeURIComponent(jsonOutput)} 
        download={fileName}
        style="display: block; text-align: center; background: #2f855a; color: white; padding: 1rem; border-radius: 6px; text-decoration: none; font-weight: bold; margin-top: 1rem;"
      >
        ⬇️ Descargar Archivo .json
      </a>
    </div>
  )}
</div>

<script>
  // Funciones globales explícitas
  window.togglePassword = function() {
    const input = document.getElementById('accessPhrase');
    const btn = document.querySelector('.toggle-pw');
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🙈';
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
    }
  };

  window.updatePreview = function() {
    // Esta función es opcional si quisieras ver el slug en tiempo real antes de enviar
    // Por ahora solo limpiamos errores visuales si los hubiera
  };

  window.copyToClipboard = function() {
    const jsonText = document.getElementById('jsonOutput').innerText.replace('Copiar', '').trim();
    navigator.clipboard.writeText(jsonText).then(() => {
      const btn = document.querySelector('.copy-btn');
      btn.textContent = '¡Copiado!';
      setTimeout(() => btn.textContent = 'Copiar', 2000);
    });
  };

  // Validación básica antes de enviar
  document.getElementById('artistForm').addEventListener('submit', function(e) {
    const phrase = document.getElementById('accessPhrase').value;
    if(phrase !== "hermano-acuerdate-de-mi") {
      // No prevenimos el submit aquí para dejar que Astro lo maneje y falle silenciosamente o muestre error
      // Pero podrías agregar una alerta si prefieres
      // alert("Frase incorrecta");
      // e.preventDefault();
    }
  });
</script>

</body>
</html>