---
// src/pages/bamos-a-la-plalla.astro
// Página secreta para generación de JSON de artistas sin DB

const SECRET_PHRASE = "hermano-acuerdate-de-mi"; // ← Nueva frase secreta

let formData = null;
let jsonOutput = null;
let fileName = "";
let error = "";

// Manejo del envío del formulario (Server-side)
if (Astro.request.method === 'POST') {
  const formBody = await Astro.request.formData();
  const accessPhrase = formBody.get('accessPhrase');

  if (accessPhrase !== SECRET_PHRASE) {
    error = "🚫 Frase incorrecta. Acceso denegado.";
  } else {
    try {
      // 1. Generar SLUG primero (para usarlo en avatar y nombre de archivo)
      const nameRaw = formBody.get('name') || "Sin Nombre";
      const slug = nameRaw.toString()
        .toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Quitar acentos
        .replace(/[^a-z0-9]+/g, '-') // Reemplazar espacios y símbolos por -
        .replace(/(^-|-$)/g, ''); // Quitar guiones al inicio/final

      // 2. Procesar géneros (array desde checkbox o texto separado por comas)
      const genreRaw = formBody.get('genre') || "";
      const genreArray = genreRaw.toString().split(',').map(g => g.trim()).filter(g => g);

      // 3. Construir el objeto JSON
      const data = {
        id: slug,
        name: nameRaw,
        role: formBody.get('role') || "Artista",
        country: formBody.get('country') || "Venezuela",
        city: formBody.get('city') || "",
        genre: genreArray,
        bio: formBody.get('bio') || "",
        bioLong: formBody.get('bioLong') || "",
        // Avatar relativo basado en el slug
        avatar: `/artists/${slug}.webp`, 
        website: formBody.get('website') || "",
        social: {
          instagram: formBody.get('instagram') || "",
          youtube: formBody.get('youtube') || "",
          facebook: formBody.get('facebook') || ""
        },
        releases: [], // Se llenan después manualmente o con otra herramienta
        musicCards: [],
        metadata: {
          uuid: `urn:uuid:${crypto.randomUUID()}`,
          timestamp: new Date().toISOString(),
          operator: formBody.get('operator') || "ceo@dagklassical.com"
        },
        tagline: formBody.get('tagline') || ""
      };

      jsonOutput = JSON.stringify(data, null, 2);
      fileName = `${slug}.json`;
      formData = data; // Para mostrar en pantalla si se desea

    } catch (e) {
      console.error(e);
      error = "Error procesando los datos: " + e.message;
    }
  }
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Editor Efímero DAG</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-slate-800 font-sans p-6">
  <div class="max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-md border border-platinum">
    <h1 class="text-2xl font-bold mb-2 text-dag-burgundy">🎵 Creador de Artistas (JSON)</h1>
    <p class="mb-6 text-sm text-slate-500">Herramienta interna para generar perfiles. El archivo se descarga automáticamente.</p>

    {error && (
      <div class="mb-6 p-4 bg-red-100 text-red-700 border border-red-300 rounded">
        {error}
      </div>
    )}

    <form method="POST" class="space-y-6">
      <!-- SEGURIDAD -->
      <div class="p-4 bg-gray-100 rounded border border-gray-300">
        <label class="block font-bold mb-2">🔑 Frase de Seguridad</label>
        <input type="password" name="accessPhrase" required class="w-full p-2 border rounded" placeholder="Ingresa la frase secreta..." />
      </div>

      <!-- DATOS BÁSICOS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium mb-1">Nombre Completo *</label>
          <input type="text" name="name" required class="w-full p-2 border rounded" placeholder="Ej: Gerardo Gerulewicz" />
          <p class="text-xs text-slate-500 mt-1">El ID se generará automáticamente desde este nombre.</p>
        </div>
        <div>
          <label class="block font-medium mb-1">Rol / Instrumento *</label>
          <input type="text" name="role" required class="w-full p-2 border rounded" placeholder="Ej: Pianista y Compositor" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block font-medium mb-1">País</label>
          <input type="text" name="country" value="Venezuela" class="w-full p-2 border rounded" />
        </div>
        <div>
          <label class="block font-medium mb-1">Ciudad</label>
          <input type="text" name="city" class="w-full p-2 border rounded" placeholder="Ej: Caracas" />
        </div>
        <div>
          <label class="block font-medium mb-1">Géneros (separados por coma)</label>
          <input type="text" name="genre" class="w-full p-2 border rounded" placeholder="música-navideña, piano-clásico" />
        </div>
      </div>

      <!-- BIOGRAFÍAS -->
      <div>
        <label class="block font-medium mb-1">Bio Corta (Resumen)</label>
        <textarea name="bio" rows="3" class="w-full p-2 border rounded" placeholder="Breve descripción para tarjetas..."></textarea>
      </div>
      <div>
        <label class="block font-medium mb-1">Bio Larga (Completa)</label>
        <textarea name="bioLong" rows="8" class="w-full p-2 border rounded" placeholder="Biografía completa. Usa doble Enter para párrafos."></textarea>
        <p class="text-xs text-slate-500 mt-1">Los saltos de línea se conservarán automáticamente.</p>
      </div>

      <!-- TAGLINE Y OPERADOR -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium mb-1">Tagline (Frase destacada)</label>
          <input type="text" name="tagline" class="w-full p-2 border rounded" placeholder="Ej: La arquitectura del sonido" />
        </div>
        <div>
          <label class="block font-medium mb-1">Operator Email</label>
          <input type="email" name="operator" value="ceo@dagklassical.com" class="w-full p-2 border rounded" />
        </div>
      </div>

      <!-- REDES SOCIALES -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block font-medium mb-1">Instagram URL</label>
          <input type="url" name="instagram" class="w-full p-2 border rounded" placeholder="https://instagram.com/..." />
        </div>
        <div>
          <label class="block font-medium mb-1">YouTube URL</label>
          <input type="url" name="youtube" class="w-full p-2 border rounded" placeholder="https://youtube.com/..." />
        </div>
        <div>
          <label class="block font-medium mb-1">Facebook URL</label>
          <input type="url" name="facebook" class="w-full p-2 border rounded" placeholder="https://facebook.com/..." />
        </div>
      </div>
      
      <div>
         <label class="block font-medium mb-1">Sitio Web (Opcional)</label>
         <input type="url" name="website" class="w-full p-2 border rounded" placeholder="https://..." />
      </div>

      <!-- BOTÓN GENERAR -->
      <button type="submit" class="w-full bg-dag-burgundy text-white font-bold py-3 rounded hover:bg-opacity-90 transition">
        ✨ Generar JSON y Descargar
      </button>
    </form>

    <!-- RESULTADO (Solo visible tras éxito) -->
    {jsonOutput && (
      <div class="mt-8 pt-8 border-t border-platinum">
        <h2 class="text-xl font-bold mb-4 text-green-700">✅ ¡Éxito! Archivo generado</h2>
        
        <div class="bg-gray-900 text-green-400 p-4 rounded font-mono text-sm overflow-x-auto mb-4">
          <pre>{jsonOutput}</pre>
        </div>

        <div class="flex gap-4">
          <a 
            href={`data:application/json;charset=utf-8,${encodeURIComponent(jsonOutput)}`} 
            download={fileName}
            class="bg-green-600 text-white px-6 py-2 rounded font-bold hover:bg-green-700 flex items-center gap-2"
          >
            ⬇️ Descargar {fileName}
          </a>
          
          <button onclick="window.location.reload()" class="bg-gray-500 text-white px-6 py-2 rounded hover:bg-gray-600">
            Crear otro
          </button>
        </div>
        
        <div class="mt-4 p-4 bg-blue-50 text-blue-800 text-sm rounded border border-blue-200">
          <strong>📸 Nota sobre la imagen:</strong> Recuerda subir la foto del artista a tu VPS o carpeta local con el nombre: <code class="bg-white px-1 rounded">{fileName.replace('.json', '.webp')}</code>
        </div>
      </div>
    )}
  </div>
</body>
</html>