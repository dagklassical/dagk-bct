---
// src/pages/blockchain/acceso/5e6c44-gerardo-gerulewicz-piano-aguinaldo.astro
import Layout from '../../../layouts/Layout.astro';
import releases from '../../../data/releases.json';

// ✅ Obtener release por ID
const releaseId = 'gerulewicz-piano-aguinaldo';
const release = releases.find(r => r.id === releaseId);
if (!release) {
  throw new Error(`Release "${releaseId}" no encontrado en releases.json`);
}

// ✅ Construir tracks desde el JSON (data-driven)
// Usamos la tracklist oficial de DAG Klassical: 15 tracks
const tracks = release.tracks.map(track => ({
  title: track.title,
  duration: track.duration.trim(),
  file: track.protected || ''
}));

const albumInfo = {
  title: release.workTitle || release.title,
  artist: "Gerardo Gerulewicz",
  description: release.descriptionLong || release.description,
  bio: "Pianista y compositor venezolano especializado en la reinterpretación de aguinaldos tradicionales con arreglos contemporáneos.",
  totalDuration: release.duration || '46:30',
  tracks
};

// ✅ Serializar para usar en el script del cliente
const tracksJson = JSON.stringify(tracks);
---

<Layout title={`Contenido Exclusivo: ${albumInfo.title} – Gerardo Gerulewicz`} description="Acceso exclusivo para poseedores de la Music Card. Audio FLAC, partitura digital y notas del compositor.">
  <!-- Hero full viewport con CTA -->
  <div class="relative h-screen w-full overflow-hidden">
    <img 
      src="https://audio.dagklassical.com/protected/audio/gerulewicz-piano-aguinaldo/hero-gg-tocando-kolendy-embajada-polonia.webp"
      alt={`${albumInfo.title} – Gerardo Gerulewicz`}
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover"
      onerror="this.src='/covers/gerulewicz-aguinaldo.jpg'"
    />
    
    <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
      <div class="max-w-4xl mx-auto px-4 text-white text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-2">{albumInfo.title}</h1>
        <p class="text-xl mb-4">por Gerardo Gerulewicz</p>
        <p class="text-lg opacity-90 mb-8">{albumInfo.totalDuration} • {albumInfo.tracks.length} pistas</p>
        
        <!-- ✅ CTA con ID para scroll suave -->
        <a href="#descargas-section" id="hero-cta" class="inline-block bg-dag-burgundy text-white px-8 py-4 rounded-lg hover:bg-opacity-90 font-medium text-lg">
          ↓ Descargar Contenido Exclusivo
        </a>
      </div>
    </div>
  </div>

  <article class="max-w-6xl mx-auto px-4 py-12 pb-32">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Columna izquierda: Biografía -->
      <div class="space-y-8">
        <section>
          <h2 class="text-2xl font-advent font-semibold mb-4">Sobre el Álbum</h2>
          <p class="text-slate-700 leading-relaxed whitespace-pre-line">
            {albumInfo.description}
          </p>
        </section>
        
        <section>
          <h2 class="text-2xl font-advent font-semibold mb-4">Sobre el Artista</h2>
          <p class="text-slate-700 leading-relaxed">
            Pianista y compositor venezolano especializado en la reinterpretación de aguinaldos tradicionales con arreglos contemporáneos.
          </p>
          
          <!-- ✅ Desplegable con fade in/out -->
          <div class="mt-4">
            <button 
              id="toggle-bio-btn"
              class="text-dag-burgundy hover:underline font-medium flex items-center gap-1 transition-colors"
            >
              <span id="bio-toggle-text">Ver biografía completa</span>
              <svg id="bio-arrow" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <!-- ✅ Contenedor con transición de opacidad -->
            <div id="full-bio-container" class="mt-3 overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0">
              <div class="bg-gray95 p-4 rounded-lg prose prose-slate max-w-none text-slate-700 space-y-4">
                <p>Gerardo Gerulewicz nació en Caracas, Venezuela, en 1968. Estudió piano en el Conservatorio Vicente Emilio Sojo bajo la tutela de maestros como Sylvia Constantinidis y Beatriz Zúñiga.</p>
                <p>Su formación continuó en Europa, donde profundizó en la interpretación del repertorio clásico y contemporáneo. Sin embargo, fue su regreso a Venezuela lo que marcó un giro decisivo en su carrera: la redescubierta de los aguinaldos tradicionales como fuente inagotable de inspiración.</p>
                <p>Desde entonces, Gerulewicz ha dedicado su obra a la relectura de estas piezas populares, infundiéndolas con lenguajes armónicos del jazz, la música impresionista y el minimalismo contemporáneo. Su enfoque no busca reemplazar la tradición, sino dialogar con ella desde la contemporaneidad.</p>
                <p>Ha colaborado con orquestas en América Latina y Europa, y sus grabaciones han sido elogiadas por su sensibilidad tímbrica y rigor estructural. "Piano Aguinaldo" representa la culminación de más de una década de investigación sonora sobre la navidad venezolana.</p>
                <p>Actualmente dirige talleres de música tradicional en el Sistema de Orquestas Juveniles e Infantiles de Venezuela, donde también coordina servidores para la preservación del patrimonio audiovisual musical.</p>
              </div>
            </div>
          </div>
        </section>
      </div>
      
      <!-- Columna derecha: Tracklist, Descargas, Partitura -->
      <div class="space-y-8">
        <!-- Bloque 1: Tracklist -->
        <section>
          <h2 class="text-2xl font-advent font-semibold mb-4">Tracklist</h2>
          <div class="bg-white p-6 rounded-lg border border-platinum">
            <ol class="space-y-3">
              {albumInfo.tracks.map((track, index) => (
                <li class="flex justify-between items-center border-b border-slate-100 pb-2 last:border-0">
                  <span class="flex-grow">{index + 1}. {track.title}</span>
                  <span class="text-slate-500 text-sm ml-4 whitespace-nowrap">{track.duration}</span>
                  <button data-track-index={index} class="text-dag-burgundy hover:underline text-sm ml-4">
                    Escuchar
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </section>
        
        <!-- Bloque 2: Descargas -->
        <section id="descargas-section">
          <h2 class="text-2xl font-advent font-semibold mb-4">Descargas</h2>
          <div class="space-y-4">
            <a 
              href="https://audio.dagklassical.com/protected/audio/gerulewicz-piano-aguinaldo/gerulewicz-piano-aguinaldo-complete.flac" 
              download="Gerardo-Gerulewicz_Piano-Aguinaldo_Complete.flac"
              class="block bg-dag-burgundy text-white px-6 py-3 rounded-lg hover:bg-opacity-90 transition-colors font-medium text-center"
            >
              Descargar Álbum Completo (FLAC)
            </a>
          </div>
        </section>
        
        <!-- Bloque 3: Partitura Digital -->
        <section>
          <h3 class="font-semibold mb-3">Partitura Digital</h3>
          <p class="text-slate-700 mb-3">Partitura completa en PDF, firmada por Gerardo Gerulewicz.</p>
          <a 
            href="https://audio.dagklassical.com/protected/audio/gerulewicz-piano-aguinaldo/gerulewicz-partitura.pdf" 
            download
            class="text-dag-burgundy hover:underline font-medium"
          >
            Descargar Partitura →
          </a>
        </section>
      </div>
    </div>
    
    <!-- ✅ Especificaciones Técnicas y Créditos (estilo demo) -->
    <div class="max-w-4xl mx-auto mt-12 pt-8 border-t border-platinum">
      <div class="mb-8 p-5 border border-platinum rounded-lg bg-white">
        <h4 class="font-semibold mb-2">Especificaciones Técnicas</h4>
        <div class="flex flex-wrap gap-2">
          <span class="px-2 py-1 bg-black/5 text-slate-800 text-xs font-mono rounded">FLAC 24/192</span>
          <span class="px-2 py-1 bg-black/5 text-slate-800 text-xs font-mono rounded">MP3 320 kbps</span>
          <span class="px-2 py-1 bg-dag-burgundy/10 text-dag-burgundy text-xs font-mono rounded">Certificado en Polygon</span>
          <span class="px-2 py-1 bg-black/5 text-slate-800 text-xs font-mono rounded">Duración: {albumInfo.totalDuration}</span>
        </div>
        <p class="mt-3 text-sm text-slate-600">
          Edición Estándar • Blockchain: Polygon • Acceso Premium Incluido
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
        <div class="flex flex-col justify-end">
          <div class="p-4 border border-platinum rounded-md bg-white/50">
            <p class="text-xs text-slate-600 font-mono leading-relaxed">
              <span class="text-dag-burgundy font-semibold">UUID:</span><br/>
              {release.metadata?.uuid || 'urn:uuid:a1b2c3d4-5678-90ab-cdef-123456789002'}
            </p>
            <p class="text-xs text-slate-600 font-mono mt-2">
              <span class="text-dag-burgundy font-semibold">Timestamp:</span><br/>
              {release.metadata?.timestamp || '2025-11-25T10:00:00Z'}
            </p>
            <p class="text-xs text-slate-600 font-mono mt-2">
              <span class="text-dag-burgundy font-semibold">Operador:</span><br/>
              cto@dagklassical.com
            </p>
          </div>
        </div>
        <div class="md:col-span-2 p-4 border border-platinum rounded-md bg-white/50">
          <p class="text-xs text-slate-600 font-mono leading-relaxed">
            <span class="text-dag-burgundy font-semibold">CRÉDITOS: </span>
            Piano y arreglos: Gerardo Gerulewicz | Mezcla y mastering: Danilo Álvarez | 
            Arte: Leo Gerulewicz | Diseño: Lorien Gascón Rojas | Mezclado y masterizado en Mansa Studio®, Lechería, Venezuela.
          </p>
        </div>
      </div>
    </div>
  </article>

  <!-- Player fijo -->
  <div class="fixed bottom-0 left-0 right-0 bg-white/40 backdrop-blur-sm border-t border-platinum p-4 z-50">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-4">
        <button id="prev-btn" class="text-dag-burgundy text-xl">⏮</button>
        <audio 
          id="fixed-player" 
          controls 
          class="w-80"
          data-tracks={tracksJson}
        ></audio>
        <button id="next-btn" class="text-dag-burgundy text-xl">⏭</button>
      </div>
      <div class="text-base font-medium text-slate-900 min-w-[200px] text-right">
        <span id="current-track">Selecciona una pista</span>
      </div>
    </div>
  </div>

  <!-- ✅ Script completo con corrección de null -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const player = document.getElementById('fixed-player');
      const tracks = player ? JSON.parse(player.dataset.tracks || '[]') : [];
      
      let currentTrackIndex = -1;
      const trackNameElement = document.getElementById('current-track');

      function playTrack(index: number) {
        if (!player || !trackNameElement || index < 0 || index >= tracks.length) return;
        const track = tracks[index];
        if (!track.file) return;
        const url = `https://audio.dagklassical.com/protected/audio/gerulewicz-piano-aguinaldo/${track.file}`;
        if (player instanceof HTMLAudioElement) {
          player.src = url;
          player.load();
          player.play().catch(err => console.warn('Reproducción fallida:', err));
        }
        trackNameElement.textContent = `${index + 1}. ${track.title}`;
        currentTrackIndex = index;
      }

      // Navegación
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      if (prevBtn) prevBtn.addEventListener('click', () => { if (currentTrackIndex > 0) playTrack(currentTrackIndex - 1); });
      if (nextBtn) nextBtn.addEventListener('click', () => { if (currentTrackIndex < tracks.length - 1) playTrack(currentTrackIndex + 1); });

      // Tracklist
      document.querySelectorAll('button[data-track-index]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget;
          if (target instanceof Element) {
            const indexStr = target.getAttribute('data-track-index');
            const index = indexStr ? parseInt(indexStr, 10) : -1;
            if (index >= 0) playTrack(index);
          }
        });
      });

      // Scroll suave
      const heroCta = document.getElementById('hero-cta');
      if (heroCta) {
        heroCta.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById('descargas-section');
          if (target) {
            const offsetTop = target.offsetTop - 85;
            window.scrollTo({ top: offsetTop, behavior: 'smooth' });
          }
        });
      }

      // Fade in/out biografía
      const toggleBtn = document.getElementById('toggle-bio-btn');
      const bioContainer = document.getElementById('full-bio-container');
      const bioText = document.getElementById('bio-toggle-text');
      const arrow = document.getElementById('bio-arrow');
      
      let isExpanded = false;
      
      if (toggleBtn && bioContainer && bioText && arrow) {
        toggleBtn.addEventListener('click', () => {
          isExpanded = !isExpanded;
          
          if (isExpanded) {
            const content = bioContainer.querySelector('div');
            const height = content ? content.scrollHeight : 0;
            
            bioContainer.style.maxHeight = height + 'px';
            bioContainer.style.opacity = '1';
            bioContainer.style.paddingTop = '0.75rem';
            bioContainer.style.paddingBottom = '0.75rem';
            
            bioText.textContent = 'Ver menos';
            arrow.style.transform = 'rotate(180deg)';
          } else {
            bioContainer.style.maxHeight = '0';
            bioContainer.style.opacity = '0';
            bioContainer.style.paddingTop = '0';
            bioContainer.style.paddingBottom = '0';
            
            bioText.textContent = 'Ver biografía completa';
            arrow.style.transform = 'rotate(0deg)';
          }
        });
      }
    });
  </script>
</Layout>