---
// src/pages/blockchain/acceso/[token].astro
import Layout from '../../../layouts/Layout.astro';
import ImmutableStamp from '../../../components/ImmutableStamp.astro';

// ✅ Esta página NO se prerrenderiza: el token es arbitrario
export const prerender = false;

// Obtiene el token de la URL
const { token } = Astro.params;

// 🔐 Aquí irá tu lógica real de validación (API, base de datos, etc.)
// Por ahora, simulamos con un conjunto fijo (solo para demo)
const validDemoTokens = new Set([
  'gerulewicz-aguinaldo',
  'capa8-test',
  'dag-klassical-demo'
]);

const isValid = validDemoTokens.has(token);
const title = isValid ? 'Acceso concedido' : 'Token inválido';
const description = isValid
  ? 'Contenido exclusivo protegido por token.'
  : 'El token proporcionado no es válido o ha expirado.';

// ✅ Breadcrumbs sin incluir el token (no es legible ni útil)
const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Blockchain', href: '/blockchain' },
  { label: 'Acceso Privado', href: '/blockchain/acceso' },
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    {isValid ? (
      <>
        <h1 class="text-3xl font-bold mb-4">Contenido exclusivo desbloqueado</h1>
        <p class="mb-6">Gracias por tu apoyo. Aquí encontrarás materiales únicos asociados a este token.</p>

        {/* Contenido protegido */}
        <div class="bg-white p-6 rounded-lg border border-platinum">
          <h2 class="text-xl font-semibold mb-3">Acceso Premium</h2>
          <p>Este espacio mostrará tu Music Card completa, partitura firmada, notas interpretativas y opción de descarga en FLAC.</p>
          {/* Aquí integrarás tu lógica real */}
        </div>

        <div class="mt-8">
          <ImmutableStamp
            uuid={`token-${token}`}
            timestamp={new Date().toISOString()}
            operator="DAG Klassical BCT"
          />
        </div>
      </>
    ) : (
      <>
        <h1 class="text-2xl font-bold text-red-600 mb-4">Acceso denegado</h1>
        <p class="mb-4">
          El token <code class="bg-gray-200 px-1 rounded">{token}</code> no es válido.
        </p>
        <a href="/" class="inline-block text-dag-burgundy hover:underline">
          ← Volver al inicio
        </a>
      </>
    )}
  </div>
</Layout>