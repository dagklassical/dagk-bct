---
// src/pages/blockchain/acceso/index.astro
import Layout from '../../../layouts/Layout.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const tokenParam = url.searchParams.get('token');
const errorParam = url.searchParams.get('error');

// ✅ Endpoint CORRECTO: Fastify en /tokens/:id (proxy por nginx en 443)
const API_BASE_URL = 'https://audio.dagklassical.com/tokens';

// Validación vía API (solo si hay token y no hay error previo)
if (tokenParam && !errorParam) {
  try {
    // ✅ GET con token en la URL (no POST con body)
    const tokenClean = tokenParam.trim().toUpperCase();
    const apiUrl = `${API_BASE_URL}/${encodeURIComponent(tokenClean)}`;
    
    const response = await fetch(apiUrl, {
      method: 'GET',
      headers: { 
        'Origin': 'https://www.dagklassical.com',
        'Accept': 'application/json'
      },
      signal: AbortSignal.timeout(5000)
    });

    if (response.ok) {
      const result = await response.json();
      
      // ✅ Verificar token válido
      if (result.valid && result.token?.cardId) {
        // ✅ Redirigir al slug correcto (ej: 61664f-goulnara-galimchina-schubert-d960-d780)
        const slug = result.token.cardId;
        return Astro.redirect(`/blockchain/acceso/${slug}`);
      }
    }
    
    // ❌ Token inválido o respuesta inesperada
    return Astro.redirect(`/blockchain/acceso?error=token_invalido&token=${encodeURIComponent(tokenParam)}`);
  } catch (e) {
    // ❌ Error de conexión o timeout
    return Astro.redirect(`/blockchain/acceso?error=error_conexion&token=${encodeURIComponent(tokenParam)}`);
  }
}

// Mensajes de error
let title = 'Acceso a Contenido Exclusivo';
let headline = 'Verificación de Acceso';
let message = 'Ingresa tu token de acceso para disfrutar de contenido exclusivo.';
let showForm = true;

if (errorParam === 'token_invalido') {
  title = 'Acceso No Válido';
  headline = 'Acceso Restringido';
  message = 'El token ingresado no corresponde a esta Music Card, está mal escrito o ha sido revocado.';
  showForm = true;
} else if (errorParam === 'token_inactivo') {
  title = 'Acceso Inactivo';
  headline = 'Token Inactivo';
  message = 'Este token ha sido desactivado. Contacta a soporte para más información.';
  showForm = false;
} else if (errorParam === 'expirado') {
  title = 'Acceso Expirado';
  headline = 'Período Finalizado';
  message = 'El período de acceso para este token ha concluido.';
  showForm = false;
} else if (errorParam === 'error_conexion') {
  title = 'Error de Conexión';
  headline = 'No se pudo verificar';
  message = 'Intenta más tarde o contacta a soporte si el problema persiste.';
  showForm = true;
}

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Blockchain', href: '/blockchain' },
  { label: 'Acceso', href: '/blockchain/acceso' },
];
---

<Layout title={title} description="Sistema de acceso verificado para poseedores de Music Cards DAG Klassical." breadcrumbs={breadcrumbs}>
  <div class="max-w-xl mx-auto px-4 py-16">
    
    <div class="bg-platinum border border-platinum rounded-lg p-8 md:p-12">
      
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-h2 font-advent text-slate-900 mb-3">{headline}</h1>
        <p class="text-slate-600 leading-relaxed">{message}</p>
      </div>

      <!-- Debug: mostrar token recibido (solo en desarrollo) -->
      {tokenParam && import.meta.env.DEV && (
        <div class="mb-6 p-3 bg-white rounded border border-slate-200">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Token recibido</p>
          <code class="text-sm font-mono text-slate-700 break-all">{tokenParam}</code>
        </div>
      )}

      <!-- Formulario de reintento (solo si aplica) -->
      {showForm && (
        <form action="/blockchain/acceso" method="get" class="space-y-4 mb-8">
          <div>
            <label for="token-input" class="block text-sm font-medium text-slate-700 mb-2">
              {errorParam ? 'Intentar con otro token:' : 'Ingresa tu token de acceso:'}
            </label>
            <input
              id="token-input"
              type="text"
              name="token"
              placeholder="Ej: GOULNARA-001-HOUSE"
              class="w-full px-4 py-3 border border-platinum rounded focus:outline-none focus:ring-2 focus:ring-dag-burgundy focus:border-transparent font-mono text-sm"
              required
              autocomplete="off"
              autocapitalize="off"
            />
          </div>
          
          <button
            type="submit"
            class="w-full bg-dag-burgundy text-white py-3 rounded hover:bg-opacity-90 transition-colors font-medium"
          >
            {errorParam ? 'Verificar otro token' : 'Acceder'}
          </button>
        </form>
      )}

      <!-- Enlaces de navegación -->
      <div class="pt-6 border-t border-slate-300 space-y-3">
        <a 
          href="/blockchain/music-cards"
          class="block w-full text-center text-dag-burgundy hover:text-opacity-80 font-medium py-2 transition-colors"
        >
          ← Explorar Music Cards disponibles
        </a>
      </div>

    </div>

    <!-- Info adicional discreta -->
    <div class="mt-8 text-center">
      <p class="text-xs text-slate-500">
        Sistema de acceso verificado para coleccionistas DAG Klassical.
        <a href="/contacto" class="text-dag-burgundy hover:underline">¿Necesitas ayuda?</a>
      </p>
    </div>

  </div>
</Layout>