---
// src/pages/blockchain/acceso/index.astro
import Layout from '../../../layouts/Layout.astro';

const url = new URL(Astro.request.url);
const token = url.searchParams.get('token');
const error = url.searchParams.get('error');

// Si hay token válido sin error, redirigir a página de acceso
if (token && !error) {
  return Astro.redirect(`/blockchain/acceso/${token}`);
}

// Mensajes de error discretos y profesionales
let title = 'Acceso a Contenido Exclusivo';
let headline = 'Verificación de Acceso';
let message = 'Ingresa tu token de acceso para disfrutar de contenido exclusivo.';
let showForm = true;

if (error === 'token_invalido') {
  title = 'Acceso No Válido';
  headline = 'Acceso Restringido';
  message = 'El token ingresado no corresponde a esta Music Card, esta mal escrito o ha sido revocado.';
  showForm = true;
} else if (error === 'token_inactivo') {
  title = 'Acceso Inactivo';
  headline = 'Token Inactivo';
  message = 'Este token ha sido desactivado. Contacta a soporte para más información.';
  showForm = false;
} else if (error === 'expirado') {
  title = 'Acceso Expirado';
  headline = 'Período Finalizado';
  message = 'El período de acceso para este token ha concluido.';
  showForm = false;
}

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Blockchain', href: '/blockchain' },
  { label: 'Acceso', href: '/blockchain/acceso' },
];
---

<Layout title={title} description="Sistema de acceso verificado para poseedores de Music Cards DAG Klassical." breadcrumbs={breadcrumbs}>
  <div class="max-w-xl mx-auto px-4 py-16">
    
    <div class="bg-platinum border border-platinum rounded-lg p-8 md:p-12">
      
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-h2 font-advent text-slate-900 mb-3">{headline}</h1>
        <p class="text-slate-600 leading-relaxed">{message}</p>
      </div>

      <!-- Debug: mostrar token recibido (solo en desarrollo) -->
      {token && import.meta.env.DEV && (
        <div class="mb-6 p-3 bg-white rounded border border-slate-200">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Token recibido</p>
          <code class="text-sm font-mono text-slate-700 break-all">{token}</code>
        </div>
      )}

      <!-- Formulario de reintento (solo si aplica) -->
      {showForm && (
        <form action="/blockchain/acceso" method="get" class="space-y-4 mb-8">
          <div>
            <label for="token-input" class="block text-sm font-medium text-slate-700 mb-2">
              {error ? 'Intentar con otro token:' : 'Ingresa tu token:'}
            </label>
            <input
              id="token-input"
              type="text"
              name="token"
              placeholder="XXXX-XXX-XXXXXXXX"
              class="w-full px-4 py-3 border border-platinum rounded focus:outline-none focus:ring-2 focus:ring-dag-burgundy focus:border-transparent font-mono text-sm"
              required
              autocomplete="off"
            />
          </div>
          
          <button
            type="submit"
            class="w-full bg-dag-burgundy text-white py-3 rounded hover:bg-opacity-90 transition-colors font-medium"
          >
            {error ? 'Verificar Acceso' : 'Ingresar'}
          </button>
        </form>
      )}

      <!-- Enlaces de navegación -->
      <div class="pt-6 border-t border-slate-300 space-y-3">
        
        <!-- Volver atrás (historial del navegador) -->
        <button 
          onclick="history.back()"
          class="w-full text-center text-dag-burgundy hover:text-opacity-80 font-medium py-2 transition-colors"
        >
          ← Volver a la página anterior
        </button>

        <!-- O: Volver al catálogo -->
        <a 
          href="/blockchain/music-cards"
          class="block w-full text-center text-slate-600 hover:text-dag-burgundy text-sm py-2 transition-colors"
        >
          Explorar Music Cards disponibles
        </a>

      </div>

    </div>

    <!-- Info adicional discreta -->
    <div class="mt-8 text-center">
      <p class="text-xs text-slate-500">
        Sistema de acceso verificado para coleccionistas DAG Klassical.
        <a href="/contacto" class="text-dag-burgundy hover:underline">¿Necesitas ayuda?</a>
      </p>
    </div>

  </div>
</Layout>