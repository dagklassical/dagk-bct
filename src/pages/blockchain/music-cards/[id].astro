---
// src/pages/blockchain/music-cards/[id].astro
import Layout from '../../../layouts/Layout.astro';
import ImmutableStamp from '../../../components/ImmutableStamp.astro';
import ExclusiveAccessGate from '../../../components/ExclusiveAccessGate.astro';
import musicCards from '../../../data/music-cards.json';
import releases from '../../../data/releases.json';
import artists from '../../../data/artists.json';

export const prerender = true;

export async function getStaticPaths() {
  return musicCards
    .filter(card => card.status === 'disponible' || card.status === 'próximo')
    .map(card => ({ params: { id: card.id } }));
}

const { id } = Astro.params;
const card = musicCards.find(c => c.id === id && (c.status === 'disponible' || c.status === 'próximo'));

if (!card) {
  return Astro.redirect('/blockchain/music-cards');
}

// Helper seguro para enlaces
const getSocialLink = (platformName: string): string | null => {
  return card.socialLinks?.find(link => link.platform === platformName)?.url || null;
};

const spotifyUrl = getSocialLink('Spotify');
const appleMusicUrl = getSocialLink('Apple Music');
const youtubeMusicUrl = getSocialLink('YouTube Music');
const tidalUrl = getSocialLink('Tidal');
const deezerUrl = getSocialLink('Deezer');

const release = releases.find(r => r.id === card.associatedRelease);
const artistList = release?.artistIds
  ?.map(artistId => artists.find(a => a.id === artistId))
  .filter((a): a is NonNullable<typeof a> => a !== undefined) || [];

const artistNames = artistList.map(a => a.name).join(', ') || 'Artista no identificado';
const artistId = artistList.length > 0 ? artistList[0].id : 'unknown'; // para ExclusiveAccessGate

// === Calcular duración total (si hay tracks) ===
let totalDuration = "0:00";
if (release?.tracks) {
  const totalSecs = release.tracks.reduce((sum, t) => {
    if (!t.duration || typeof t.duration !== 'string') return sum;
    const parts = t.duration.split(':');
    const mins = Number(parts[0]) || 0;
    const secs = Number(parts[1]) || 0;
    return sum + (mins * 60 + secs);
  }, 0);
  const totalMins = Math.floor(totalSecs / 60);
  const totalSecsRemain = totalSecs % 60;
  totalDuration = `${totalMins}:${totalSecsRemain.toString().padStart(2, '0')}`;
}

// === Navegación Anterior/Siguiente por fecha de lanzamiento ===
const getReleaseDate = (mc: typeof musicCards[0]) => {
  const rel = releases.find(r => r.id === mc.associatedRelease);
  return rel?.releaseDate ? new Date(rel.releaseDate) : new Date(0);
};

const availableCards = musicCards.filter(c => 
  c.status === 'disponible' || c.status === 'próximo'
).sort((a, b) => getReleaseDate(a).getTime() - getReleaseDate(b).getTime());

const currentIndex = availableCards.findIndex(c => c.id === id);
const prevCard = currentIndex > 0 ? availableCards[currentIndex - 1] : null;
const nextCard = currentIndex < availableCards.length - 1 ? availableCards[currentIndex + 1] : null;

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Blockchain', href: '/blockchain' },
  { label: 'Music Cards', href: '/blockchain/music-cards' },
  { label: card.title, href: `/blockchain/music-cards/${id}` },
];
---

<Layout title={card.title} description={release?.description || 'Music Card verificable en blockchain'} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto pt-8 px-4">
    <a href="/blockchain/music-cards" class="text-slate-700 hover:text-dag-burgundy flex items-center text-sm">
      ← Volver a Music Cards
    </a>
  </div>

  <article class="max-w-4xl mx-auto px-4 pt-4 pb-10">
    <div class="flex flex-col md:flex-row gap-6">
      <div class="md:w-1/3 space-y-6">
        <img
          src={card.cardImage}
          alt={card.title}
          class="w-full rounded-md mx-auto shadow-md mt-4 object-contain"
          onerror="this.src='https://placehold.co/300x480/cccccc/999999?text=Music+Card'"
        />

        <div class="flex justify-center gap-4">
          {spotifyUrl && (
            <a href={spotifyUrl} target="_blank" rel="noopener" aria-label="Spotify" class="block w-7 h-7 hover:scale-110 transition-transform">
              <img src="/icons/spotify-color-icon.svg" alt="Spotify" class="w-full h-full" />
            </a>
          )}
          {appleMusicUrl && (
            <a href={appleMusicUrl} target="_blank" rel="noopener" aria-label="Apple Music" class="block w-7 h-7 hover:scale-110 transition-transform">
              <img src="/icons/apple-music-color-icon.svg" alt="Apple Music" class="w-full h-full" />
            </a>
          )}
          {youtubeMusicUrl && (
            <a href={youtubeMusicUrl} target="_blank" rel="noopener" aria-label="YouTube Music" class="block w-7 h-7 hover:scale-110 transition-transform">
              <img src="/icons/youtube-music-color-icon.svg" alt="YouTube Music" class="w-full h-full" />
            </a>
          )}
          {tidalUrl && (
            <a href={tidalUrl} target="_blank" rel="noopener" aria-label="Tidal" class="block w-7 h-7 hover:scale-110 transition-transform">
              <img src="/icons/tidal-color-icon.svg" alt="Tidal" class="w-full h-full" />
            </a>
          )}
          {deezerUrl && (
            <a href={deezerUrl} target="_blank" rel="noopener" aria-label="Deezer" class="block w-7 h-7 hover:scale-110 transition-transform">
              <img src="/icons/deezer-color-icon.svg" alt="Deezer" class="w-full h-full" />
            </a>
          )}
        </div>

        <div class="bg-white border border-platinum rounded-xl px-4 py-3">
          <audio id="music-player" controls class="w-full h-16 mb-3" preload="none"></audio>
        </div>

        {release?.tracks && (
          <section class="bg-white p-5 rounded-lg border border-platinum max-h-[300px] overflow-y-auto">
            <h3 class="text-lg font-semibold mb-3">Tracklist</h3>
            <ol class="space-y-2">
              {release.tracks.map((track, i) => {
                const demoSrc = typeof track.demo === 'string' ? track.demo : null;
                return (
                  <li 
                    data-demo={demoSrc}
                    class={`flex justify-between items-center px-2 py-2 text-xs border-b border-slate-100 last:border-0 cursor-pointer hover:bg-slate-50 ${
                      i % 2 === 0 ? 'bg-gray95/40' : 'bg-gray95'
                    }`} 
                  >
                    <span class="font-medium">{i + 1}. {track.title}</span>
                    <span class="text-slate-500 text-sm">{track.duration}</span>
                  </li>
                );
              })}
            </ol>
          </section>
        )}
      </div>

      <div class="md:w-2/3 pt-1">
        <h1 class="text-h1 font-advent mb-2">{card.title}</h1>
        <p class="text-xl text-slate-600 mb-4">
          por {artistNames} · 
          <span class="px-2 py-2 bg-dag-burgundy/5 text-dag-burgundy text-xs font-mono rounded-s-sm">
            DISPONIBLES {card.available} / {card.totalSupply}
          </span>
        </p>

        {release?.description && <p class="mb-5 text-slate-700">{release.description}</p>}

        <section class="mb-12">
          <h3 class="text-h3 font-advent mb-3">Privilegios propios</h3>
          <ul class="list-disc pl-5 space-y-1 mb-2">
            {card.benefits.map((benefit) => (
              <li class="text-slate-700">{benefit}</li>
            ))}
          </ul>
          <ExclusiveAccessGate artistId={artistId} />
        </section>

        <!-- === SOBRE EL(LOS) ARTISTA(S) === -->
        {artistList.length === 1 ? (
          <section class="mb-8 bg-gray95 p-4 rounded-md">
            <h3 class="text-h3 font-advent mb-3">Sobre {artistList[0].name}</h3>
            {artistList[0].bio && (
              <p class="text-slate-700 mb-3">{artistList[0].bio}</p>
            )}
            <a 
              href={`/musica/artistas/${artistList[0].id}`} 
              class="text-dag-burgundy hover:underline text-sm inline-block"
            >
              Ver biografía completa →
            </a>
          </section>
        ) : (
          <section class="mb-8 bg-gray95 p-4 rounded-md">
            <h3 class="text-h3 font-advent mb-3">Conoce a los artistas</h3>
            <p class="text-slate-700 mb-3">
              Para una mejor experiencia y conocer el universo artístico de cada creador, 
              te invitamos a explorar sus perfiles individuales.
            </p>
            <div class="flex flex-wrap gap-2">
              {artistList.map(artist => (
                <a
                  href={`/musica/artistas/${artist.id}`}
                  class="inline-block bg-white px-3 py-1.5 rounded text-sm border border-platinum hover:bg-dag-burgundy/5 transition-colors"
                >
                  {artist.name}
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="mb-8 p-5 border border-platinum rounded-lg bg-white">
          <h4 class="font-semibold mb-2">Especificaciones Técnicas</h4>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-black/5 text-slate-800 text-xs font-mono rounded">FLAC 24/192</span>
            <span class="px-2 py-1 bg-black/5 text-slate-800 text-xs font-mono rounded">MP3 320 kbps</span>
            <span class="px-2 py-1 bg-dag-burgundy/10 text-dag-burgundy text-xs font-mono rounded">Certificado en Polygon</span>
            <span class="px-2 py-1 bg-black/5 text-slate-800 text-xs font-mono rounded">Duración: {totalDuration}</span>
          </div>
          <p class="mt-3 text-sm text-slate-600">
            {card.edition} • {card.blockchain} • {card.price}
          </p>
        </section>
      </div>
    </div>

    <div class="max-w-4xl mx-auto mt-8 pt-2 border-t border-platinum">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
        <div class="flex flex-col justify-end">
          <ImmutableStamp
            uuid={card.metadata.uuid}
            timestamp={card.metadata.timestamp}
            operator={card.metadata.operator}
          />
        </div>
        <div class="md:col-span-2 p-4 border border-platinum rounded-md bg-white/50">
          <p class="text-xs text-slate-600 font-['Source_Code_Pro'] leading-relaxed">
            <span class="text-dag-burgundy">CRÉDITOS: </span>
            Piano y arreglos: {artistNames} | Mezcla y mastering: Danilo Álvarez | 
            Arte: Leo Gerulewicz | Diseño: Lorien Gascón Rojas | Mezclado y masterizado en Mansa Studio®, Lechería, Venezuela.</p>
        </div>
      </div>
    </div>

    <!-- ✅ Navegación Anterior/Siguiente por fecha de lanzamiento -->
    {(prevCard || nextCard) && (
      <nav class="mt-12 pt-6 border-t border-platinum flex flex-col sm:flex-row justify-between gap-4">
        {prevCard ? (
          <a 
            href={`/blockchain/music-cards/${prevCard.id}`} 
            class="flex items-center text-dag-burgundy hover:text-opacity-80 text-sm"
          >
            ← Anterior: {prevCard.title}
          </a>
        ) : <div></div>}
        
        {nextCard ? (
          <a 
            href={`/blockchain/music-cards/${nextCard.id}`} 
            class="flex items-center text-dag-burgundy hover:text-opacity-80 text-right text-sm"
          >
            Siguiente: {nextCard.title} →
          </a>
        ) : <div></div>}
      </nav>
    )}

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const player = document.getElementById('music-player') as HTMLAudioElement | null;
        const firstTrack = document.querySelector('[data-demo]') as HTMLElement | null;
        if (player && firstTrack) {
          const demoSrc = firstTrack.dataset.demo;
          if (demoSrc) {
            player.src = demoSrc;
          }
        }
      });

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const trackElement = target.closest('[data-demo]') as HTMLElement | null;
        if (!trackElement) return;

        const demoSrc = trackElement.dataset.demo;
        if (!demoSrc) return;

        const player = document.getElementById('music-player') as HTMLAudioElement | null;
        if (!player) return;

        player.src = demoSrc;
        player.load();
        player.play().catch((err: any) => {
          console.warn('Reproducción fallida:', err);
        });
      });
    </script>
  </article>
</Layout>