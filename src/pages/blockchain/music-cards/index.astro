---
// src/pages/blockchain/music-cards/index.astro
import Layout from '../../../layouts/Layout.astro';
import musicCards from '../../../data/music-cards.json';
import releases from '../../../data/releases.json';
import artists from '../../../data/artists.json';

// ✅ Tipado mínimo para evitar 'any'
interface MusicCard {
  id: string;
  title: string;
  artist?: string;
  associatedRelease: string;
  edition: string;
  price: string;
  status: string;
  cardImage?: string;
}

interface Artist {
  id: string;
  name: string;
}

interface Release {
  id: string;
  artistIds: string[];
}

// Crear Maps seguros
const artistMap = new Map(
  (Array.isArray(artists) ? artists : []).map((artist: Artist) => [artist.id, artist])
);
const releaseMap = new Map(
  (Array.isArray(releases) ? releases : []).map((release: Release) => [release.id, release])
);

const availableCards = (Array.isArray(musicCards) ? musicCards : [])
  .filter(card => card.status === 'disponible' || card.status === 'próximo');

// ✅ Función tipada
const getArtistName = (card: MusicCard) => {
  const release = releaseMap.get(card.associatedRelease);
  if (release?.artistIds?.[0]) {
    const artist = artistMap.get(release.artistIds[0]);
    if (artist?.name) return artist.name;
  }
  return card.artist || 'Artista';
};

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Blockchain', href: '/blockchain/' },
  { label: 'Music Cards', href: '/blockchain/music-cards/' },
];
---

<Layout 
  title="Music Cards Disponibles | DAG Klassical" 
  description="Colecciones únicas certificadas en blockchain. Audio en FLAC, partituras firmadas y acceso exclusivo."
  breadcrumbs={breadcrumbs}
>
  <header class="bg-white text-center py-10 px-4 mb-12">
    <h1 class="text-h1 font-advent">Adquiere tus Music Cards</h1>
    <p class="text-dag-burgundy max-w-2xl mx-auto mt-3">
      Ediciones limitadas, certificadas en blockchain, con beneficios únicos.
    </p>
  </header>

  <main class="bg-gray95 pb-16">
    <div class="max-w-6xl mx-auto px-4 py-4">
      {availableCards.length === 0 ? (
        <p class="text-center text-slate-600 py-12">No hay Music Cards disponibles en este momento.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {availableCards.map(card => {
            const artistName = getArtistName(card);
            return (
              <a 
                href={`/blockchain/music-cards/${card.id}`} 
                class="block group border border-slate-200 rounded-md hover:border-dag-burgundy/40 transition-colors bg-white shadow-sm overflow-hidden"
              >
                <div class="aspect-[5/8]">
                  <img 
                    src={card.cardImage || '/images/placeholder-card.jpg'} 
                    alt={`${card.title} por ${artistName}`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="p-4">
                  <h3 class="font-advent font-semibold text-slate-900 group-hover:text-dag-burgundy">
                    {card.title}
                  </h3>
                  <p class="text-sm text-slate-600 mt-1">{artistName}</p>
                  <p class="text-sm text-dag-burgundy mt-2">
                    {card.price} • {card.edition}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>

    <div class="text-center mt-12">
      <a 
        href="/blockchain" 
        class="inline-block bg-dag-burgundy text-white px-6 py-3 rounded-lg hover:bg-opacity-90 transition-colors"
      >
        Volver a Blockchain
      </a>
    </div>
  </main>
</Layout>